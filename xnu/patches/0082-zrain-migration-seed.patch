--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -167,6 +167,11 @@
 #include <sys/kern_overrides.h>         /* for init_system_override() */
 #include <sys/lockf.h>                  /* for lf_init() */
 #include <sys/fsctl.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+#endif
 
 #include <net/init.h>
 
@@ -1072,6 +1077,61 @@
 	bsd_init_kprintf("done\n");
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Rain diagnostic only: test whether a missing migration preference keeps
+ * backboardd from presenting the first frame. The root is mounted before
+ * bsdinit_task, and this is permitted only with the volatile UFS overlay.
+ */
+static void
+rain_seed_migration_preference(void)
+{
+	static const char path[] =
+	    "/private/var/mobile/Library/Preferences/com.apple.migration.plist";
+	static const char plist[] =
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\"><dict><key>LastSystemVersion</key>"
+	    "<string>20H392</string></dict></plist>\n";
+	uint32_t seed = 0, cow = 0, rw = 0;
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	struct vnode_attr va;
+	int error;
+
+	PE_parse_boot_argn("rainseedmigration", &seed, sizeof(seed));
+	if (seed != 1) {
+		return;
+	}
+	PE_parse_boot_argn("ufscow", &cow, sizeof(cow));
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+	if (cow != 1 || rw != 0) {
+		printf("RAIN migration seed: requires volatile UFS COW\n");
+		return;
+	}
+
+	error = vnode_open(path, O_CREAT | O_EXCL | O_WRONLY, 0644, 0, &vp, ctx);
+	if (error != 0) {
+		printf("RAIN migration seed: open failed %d\n", error);
+		return;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)plist, sizeof(plist) - 1, 0,
+	    UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), NULL, current_proc());
+	if (error == 0) {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, 501);
+		VATTR_SET(&va, va_gid, 501);
+		VATTR_SET(&va, va_mode, 0600);
+		int attr_error = vnode_setattr(vp, &va, ctx);
+		printf("RAIN migration seed: wrote build 20H392, attrs %d\n", attr_error);
+	} else {
+		printf("RAIN migration seed: write failed %d\n", error);
+	}
+	(void)vnode_close(vp, O_WRONLY, ctx);
+}
+#endif
+
 void
 bsdinit_task(void)
 {
@@ -1098,6 +1158,9 @@
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	rain_seed_migration_preference();
+#endif
 	load_init_program(p);
 	lock_trace = 1;
 }
