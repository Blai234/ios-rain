+				    (uint64_t)(sc.sy + sc.ah - 1) * s->bytesPerRow +
+				    (uint64_t)(sc.sx + sc.aw) * 4;
+				if (s->elementWidth != 1 || s->elementHeight != 1 ||
+				    s->memory == NULL || last > s->memory->getLength()) {
+					src = 0;
+				}
+			}
+			if (src != 0 && bpe == 4) {
+				uint32_t accy = 0;
+
+				for (int32_t j = 0; j < sc.ph; j++) {
+					const uint32_t *srow = (const uint32_t *)(src + s->offset +
+					    (uint64_t)sweet_fb_scale_sy(&sc, accy) * s->bytesPerRow);
+					uint32_t *drow = (uint32_t *)(fPixels +
+					    (uint64_t)(sc.py + j) * fRowBytes + (uint64_t)sc.px * 4);
+					uint32_t accx = 0;
+
+					for (int32_t i = 0; i < sc.pw; i++) {
+						drow[i] = srow[sweet_fb_scale_sx(&sc, accx)];
+						accx += sc.xstep;
+					}
+					accy += sc.ystep;
+				}
 			}
 		}
 		s->release();
