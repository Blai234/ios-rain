+/*
+ * Scaling helper for the SWEET framebuffer (SweetFramebuffer.cpp).
+ *
+ * The iOS userland is presented with the iPhone X canvas (1125x2436) while
+ * the physical panel is smaller (Rain: 720x1650). Without scaling the kernel
+ * shows the centre crop of the canvas, which hides the status bar and the
+ * home indicator. With scaling the whole canvas is resampled into the panel.
+ *
+ * The arithmetic has no IOKit dependencies, so the host test in
+ * tests/test_rain_fb_scale.py can compile and check it directly.
+ */
+#ifndef _SWEET_FB_SCALE_H
+#define _SWEET_FB_SCALE_H
+
+#include <stdint.h>
+
+struct sweet_fb_scale {
+	int32_t  px, py;          /* destination origin on the panel */
+	int32_t  pw, ph;          /* destination size on the panel */
+	uint32_t sx, sy;          /* source origin in the surface */
+	uint32_t aw, ah;          /* source size in the surface */
+	uint32_t xstep, ystep;    /* 16.16 source pixels per panel pixel */
+};
+
+/*
+ * Set up the mapping of one layer.
+ *
+ * dx, dy, dw, dh: the destination rectangle in presented (logical) pixels.
+ * sx, sy, sw, sh: the source rectangle in surface pixels.
+ * panel_w/panel_h: the panel size; logical_w/logical_h: the presented size.
+ * src_w/src_h: the source surface size.
+ *
+ * Returns 1 when the layer has to be drawn.
+ */
+static inline int
+sweet_fb_scale_setup(struct sweet_fb_scale *sc,
+    int32_t dx, int32_t dy, int32_t dw, int32_t dh,
+    int32_t sx, int32_t sy, int32_t sw, int32_t sh,
+    uint32_t panel_w, uint32_t panel_h,
+    uint32_t logical_w, uint32_t logical_h,
+    uint32_t src_w, uint32_t src_h)
+{
+	int64_t px, py, pw, ph;
+	uint64_t xstep, ystep;
+
+	if (dw <= 0 || dh <= 0 || panel_w == 0 || panel_h == 0 ||
+	    logical_w == 0 || logical_h == 0) {
+		return 0;
+	}
+	if (sw <= 0) {
+		sw = (int32_t)src_w;
+	}
+	if (sh <= 0) {
+		sh = (int32_t)src_h;
+	}
+	if (sw <= 0 || sh <= 0) {
+		return 0;
+	}
+	/* Keep the source rectangle inside the surface. */
+	if (sx < 0) {
+		sw += sx;
+		sx = 0;
+	}
+	if (sy < 0) {
+		sh += sy;
+		sy = 0;
+	}
+	if (sx + sw > (int32_t)src_w) {
+		sw = (int32_t)src_w - sx;
+	}
+	if (sy + sh > (int32_t)src_h) {
+		sh = (int32_t)src_h - sy;
+	}
+	if (sw <= 0 || sh <= 0) {
+		return 0;
+	}
+	/* The presented rectangle maps onto the panel. */
+	px = ((int64_t)dx * (int64_t)panel_w) / (int64_t)logical_w;
+	py = ((int64_t)dy * (int64_t)panel_h) / (int64_t)logical_h;
+	pw = ((int64_t)dw * (int64_t)panel_w) / (int64_t)logical_w;
+	ph = ((int64_t)dh * (int64_t)panel_h) / (int64_t)logical_h;
+	if (pw < 1) {
+		pw = 1;
+	}
+	if (ph < 1) {
+		ph = 1;
+	}
+	if (px < 0) {
+		pw += px;
+		px = 0;
+	}
+	if (py < 0) {
+		ph += py;
+		py = 0;
+	}
+	if (px + pw > (int64_t)panel_w) {
+		pw = (int64_t)panel_w - px;
+	}
+	if (py + ph > (int64_t)panel_h) {
+		ph = (int64_t)panel_h - py;
+	}
+	if (pw <= 0 || ph <= 0) {
+		return 0;
+	}
+	/* Source pixels per panel pixel, in 16.16. */
+	xstep = ((uint64_t)logical_w * (uint64_t)sw * 65536) /
+	    ((uint64_t)panel_w * (uint64_t)dw);
+	ystep = ((uint64_t)logical_h * (uint64_t)sh * 65536) /
+	    ((uint64_t)panel_h * (uint64_t)dh);
+	if (xstep > 0x7fffffffu) {
+		xstep = 0x7fffffffu;
+	}
+	if (ystep > 0x7fffffffu) {
+		ystep = 0x7fffffffu;
+	}
+	sc->px = (int32_t)px;
+	sc->py = (int32_t)py;
+	sc->pw = (int32_t)pw;
+	sc->ph = (int32_t)ph;
+	sc->sx = (uint32_t)sx;
+	sc->sy = (uint32_t)sy;
+	sc->aw = (uint32_t)sw;
+	sc->ah = (uint32_t)sh;
+	sc->xstep = (uint32_t)xstep;
+	sc->ystep = (uint32_t)ystep;
+	return 1;
+}
+
+/* Source column and row for a 16.16 accumulator, clamped to the source rect. */
+static inline uint32_t
+sweet_fb_scale_sx(const struct sweet_fb_scale *sc, uint32_t acc)
+{
+	uint32_t x = sc->sx + (acc >> 16);
+	uint32_t last = sc->sx + sc->aw - 1;
+	return x > last ? last : x;
+}
+
+static inline uint32_t
+sweet_fb_scale_sy(const struct sweet_fb_scale *sc, uint32_t acc)
+{
+	uint32_t y = sc->sy + (acc >> 16);
+	uint32_t last = sc->sy + sc->ah - 1;
+	return y > last ? last : y;
+}
+
+#endif /* _SWEET_FB_SCALE_H */
