 static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
 
+/* Volatile block overlay, guarded by sweet_ufs_lock. Index 0 means absent. */
+#define COW_BUCKETS 4096u
+#define COW_MAX_BLOCKS 16384u                 /* at most 64 MiB of block data */
+static struct {
+	uint64_t lba;
+	uint32_t next;
+	uint8_t *data;
+} cow_blocks[COW_MAX_BLOCKS + 1];
+static uint32_t cow_bucket[COW_BUCKETS];
+static uint32_t cow_used;
+
+static uint32_t
+cow_lookup(uint64_t lba)
+{
+	for (uint32_t n = cow_bucket[lba % COW_BUCKETS]; n; n = cow_blocks[n].next) {
+		if (cow_blocks[n].lba == lba) {
+			return n;
+		}
+	}
+	return 0;
+}
+
+static int
+cow_store(uint64_t lba, const uint8_t *data)
+{
+	uint32_t n = cow_lookup(lba);
+	if (!n) {
+		if (cow_used == COW_MAX_BLOCKS) {
+			printf("SWEET UFS COW: 64 MiB limit reached\n");
+			return ENOSPC;
+		}
+		uint8_t *block = kalloc_data(UFS_BLOCK, Z_WAITOK);
+		if (!block) {
+			return ENOMEM;
+		}
+		n = ++cow_used;
+		cow_blocks[n].data = block;
+		cow_blocks[n].lba = lba;
+		uint32_t bucket = (uint32_t)(lba % COW_BUCKETS);
+		cow_blocks[n].next = cow_bucket[bucket];
+		cow_bucket[bucket] = n;
+	}
+	memcpy(cow_blocks[n].data, data, UFS_BLOCK);
+	return 0;
+}
+
