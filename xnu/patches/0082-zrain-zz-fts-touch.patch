+/*
+ * Rain (Redmi 10C) FT8006S touchscreen on the GENI SPI block.
+ *
+ * The controller is a Focaltech FT8006S (chip id 0x8642) on GENI SPI at
+ * 0x4a80000, chip select 0. The live device tree has the SPI pins on
+ * GPIO 0..3 muxed to qup0, the interrupt on GPIO 80 and the reset on
+ * GPIO 86. Android drives it with the fts_ts driver; the inherited XNU
+ * touch driver only speaks I2C on Sweet's SE7, so it cannot reach it.
+ *
+ * Stage 1 is the transport and the controller identity:
+ *   - what the pinctrl and the GENI block look like right now,
+ *   - the Focaltech SPI framing (a four byte header, three dummy bytes and
+ *     a CRC-16/KERMIT over the payload),
+ *   - the chip id read.
+ * The report parser and the firmware loader follow once the chip answers.
+ *
+ * Everything is bounded and runs on one worker thread: a failure here must
+ * not stop the rest of the system from booting.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* osfmk/vm/pmap.h keeps it from the BSD layer; sweet_ufs.c does the same. */
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void rain_touch_init(void);
+
+/* Hardware. */
+#define FTS_GENI_PA      0x04a80000u
+#define FTS_GENI_LEN     0x00004000u
+/*
+ * The TLMM (the device tree's pinctrl@400000) is not flat: the GPIO number
+ * selects a tile and the pin sits at tile + number * 0x1000. On this SoC
+ * (the bengal pinctrl driver) the tiles are WEST at +0x100000, SOUTH at
+ * +0x500000, EAST at +0x900000 and the base tile is unused. The touch's
+ * pins are all in WEST: GPIO 0..3 are the qup0 SPI pins, GPIO 80 is the
+ * interrupt and GPIO 86 the reset. Reading a pin in the wrong tile hits
+ * an unimplemented register aperture, which aborts the board.
+ */
+#define FTS_TLMM_PA      0x00500000u
+#define FTS_TLMM_LEN     0x00060000u
+#define FTS_TLMM_STRIDE  0x00001000u
+#define FTS_SPI_PINS     0u          /* GPIO 0..3: the qup0 SPI pins */
+#define FTS_SPI_PIN_N    4u
+#define FTS_IRQ_GPIO     80u
+#define FTS_RESET_GPIO   86u
+#define FTS_RESET_LOOPS  20u
+
+/* The GENI serial engine register map. It is the same map Sweet's SE7 I2C
+ * engine uses, so the offsets and the byte order carry over unchanged. */
+#define SE_FORCE_DEFAULT 0x020u
+#define SE_OUTPUT_CTRL   0x024u
+#define SE_CGC_CTRL      0x028u
+#define SE_STATUS        0x040u
+#define SE_IF_DISABLE    0x064u
+#define SE_MCLK          0x048u
+#define SE_FW            0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_PACK0_TX      0x260u
+#define SE_PACK1_TX      0x264u
+#define SE_PACK0_RX      0x284u
+#define SE_PACK1_RX      0x288u
+#define SE_CMD           0x600u
+#define SE_CTRL          0x604u
+#define SE_IRQ           0x610u
+#define SE_IRQ_EN        0x614u
+#define SE_IRQ_CLR       0x618u
+#define SE_TX            0x700u
+#define SE_RX            0x780u
+#define SE_TX_COUNT      0x800u
+#define SE_RX_COUNT      0x804u
+#define SE_TX_WM         0x80cu
+#define SE_RX_WM         0x810u
+#define SE_RX_RFR_WM     0x814u
+#define SE_DMA_MODE      0x258u
+#define SE_IOS           0x908u
+#define SE_GSI_EVENT_EN  0xe18u
+#define SE_IRQ_ROUTE     0xe1cu
+#define SE_DMA_GEN_CFG   0xe30u
+#define SE_HW_TX         0xe24u
+#define SE_HW_RX         0xe28u
+
+/* The SPI specific registers of the same block. */
+#define SE_SPI_CPHA      0x224u
+#define SE_SPI_LOOPBACK  0x22cu
+#define SE_SPI_CPOL      0x230u
+#define SE_SPI_DEMUX_INV 0x24cu
+#define SE_SPI_DEMUX_SEL 0x250u
+#define SE_SPI_TRANS_CFG 0x25cu
+#define SE_SPI_WORD_LEN  0x268u
+#define SE_SPI_TX_LEN    0x26cu
+#define SE_SPI_RX_LEN    0x270u
+#define SE_SPI_DELAY     0x278u
+
+/* GENI fields. */
+#define FW_REV_PROTOCOL_MSK  0xff00u
+#define FW_REV_PROTOCOL_SHFT 8u
+#define PROTO_SPI            1u
+#define FIFO_IF_DISABLE      0x00000001u
+#define DEFAULT_CGC_EN       0x0000007fu /* the AHB, serial, TX, RX, ext clocks */
+#define DEFAULT_IO_OUTPUT    0x0000007fu
+#define DMA_GEN_CGC_ON       0x0000000fu /* RX, TX, AHB slave, secure slave */
+#define GENI_M_IRQ_ROUTE     0x00000004u
+#define GENI_S_IRQ_ROUTE     0x00000008u
+#define DMA_IRQ_ROUTE        0x00000003u
+#define M_CMD_DONE_EN        0x00000001u
+#define M_RX_FIFO_WM_EN      0x04000000u
+#define M_RX_FIFO_LAST_EN    0x08000000u
+#define M_TX_FIFO_WM_EN      0x40000000u
+#define M_CMD_DONE           0x00000001u
+#define M_CMD_ABORT          0x00000002u
+#define M_CMD_CANCEL         0x00000004u
+#define M_CMD_OVERRUN        0x00000002u
+#define M_ILLEGAL_CMD        0x00000004u
+#define M_CMD_FAILURE        0x00000008u
+#define SPI_TX_ONLY          1u
+#define SPI_RX_ONLY          2u
+#define M_OPCODE_SHFT        27u
+#define TX_FIFO_DEPTH_MSK    0x003f0000u
+#define TX_FIFO_DEPTH_SHFT   16u
+#define TX_FIFO_WIDTH_MSK    0x3f000000u
+#define TX_FIFO_WIDTH_SHFT   24u
+#define RX_FIFO_DEPTH_MSK    0x003f0000u
+#define RX_FIFO_DEPTH_SHFT   16u
+#define RX_FIFO_WIDTH_MSK    0x3f000000u
+#define RX_FIFO_WIDTH_SHFT   24u
+#define TX_FIFO_WC_MSK       0x0fffffffu
+#define RX_FIFO_WC_MSK       0x01ffffffu
+
+/* The packing for eight bit words, four per FIFO word, most significant
+ * bit first. These are the values Sweet's I2C engine already uses. */
+#define SE_PACK0            0x0007f8feu
+#define SE_PACK1            0x000ffefeu
+
+/* The Focaltech SPI framing. */
+#define FTS_WRITE_CMD       0x00u
+#define FTS_READ_CMD        0xa0u    /* 0x80 | DATA_CRC_EN */
+#define FTS_HEADER_LEN      4u
+#define FTS_DUMMY_BYTES     3u
+#define FTS_MAX_XFER        256u
+#define FTS_CHIP_ID_REG     0x90u    /* FTS_CMD_READ_ID */
+#define FTS_FW_VER_REG      0xa6u    /* firmware version in app mode */
+#define FTS_MAX_TOUCH       10u
+#define FTS_TOUCH_REG       0x01u    /* touch data starts here */
+#define FTS_TOUCH_LEN       62u      /* 2 header + 60 point bytes */
+
+/* Khaje GCC: wrap0's voted clocks and SE0 RCG (gcc-khaje.c). */
+#define FTS_GCC_PA       0x01400000u
+#define FTS_GCC_LEN      0x00080000u
+#define FTS_GCC_VOTE     0x0007900cu
+#define FTS_GCC_SE0_RCG  0x0001f148u
+#define FTS_GCC_VOTE_MASK 0x000007c0u /* AHB, core, core2x, SE0 */
+#define FTS_GCC_SE0_CBCR 0x0001f144u
+#define FTS_GCC_CORE_CBCR 0x0001f00cu
+
+/*
+ * GPI DMA (qcom,gpi-dma@4a00000). SE0's FIFO interface is disabled in
+ * hardware (GENI_IF_DISABLE_RO bit 0), so its bytes can only move through
+ * the GPI, as Android's spi-geni does. The layout is the upstream Linux
+ * gpi.c one: the GPII registers are at base + offset - qcom,gpi-ee-offset
+ * (0x10000). qcom,gpii-mask 0xf gives the application processor GPIIs
+ * 0..3; SE0's dmas cells are <tx ch 0, rx ch 1, se 0, proto SPI, 64 TREs>.
+ */
+#define GPI_PA           0x04a00000u
+#define GPI_LEN          0x00060000u
+#define GPI_EE_OFF       0x00010000u
+#define GPI_GPII         0u
+#define GPI_N            (0x4000u * GPI_GPII)
+#define GPI_CH_CNTXT(k)  (0x20000u + GPI_N + 0x80u * (k))
+#define GPI_CH_QOS(k)    (0x2005cu + GPI_N + 0x80u * (k))
+#define GPI_CH_SCRATCH(k, j) (0x20060u + GPI_N + 0x80u * (k) + 4u * (j))
+#define GPI_EV_CNTXT     (0x21000u + GPI_N)
+#define GPI_CH_DB(k)     (0x22000u + GPI_N + 0x8u * (k))
+#define GPI_EV_DB        (0x22100u + GPI_N)
+#define GPI_CH_CMD       (0x23008u + GPI_N)
+#define GPI_EV_CMD       (0x23010u + GPI_N)
+#define GPI_TYPE_IRQ     (0x23080u + GPI_N)
+#define GPI_TYPE_IRQ_MSK (0x23088u + GPI_N)
+#define GPI_SRC_CH_IRQ   (0x23090u + GPI_N)
+#define GPI_SRC_EV_IRQ   (0x23094u + GPI_N)
+#define GPI_SRC_CH_MSK   (0x23098u + GPI_N)
+#define GPI_SRC_EV_MSK   (0x2309cu + GPI_N)
+#define GPI_SRC_CH_CLR   (0x230a0u + GPI_N)
+#define GPI_SRC_EV_CLR   (0x230a4u + GPI_N)
+#define GPI_IEOB_MSK     (0x230b8u + GPI_N)
+#define GPI_IEOB_CLR     (0x230c0u + GPI_N)
+#define GPI_GLOB_STTS    (0x23100u + GPI_N)
+#define GPI_GLOB_EN      (0x23108u + GPI_N)
+#define GPI_GPII_STTS    (0x23118u + GPI_N)
+#define GPI_GPII_EN      (0x23120u + GPI_N)
+#define GPI_INTSET       (0x23180u + GPI_N)
+#define GPI_MSI_LSB      (0x23188u + GPI_N)
+#define GPI_MSI_MSB      (0x2318cu + GPI_N)
+#define GPI_ERROR_LOG    (0x23200u + GPI_N)
+#define GPI_SCRATCH0     (0x23400u + GPI_N)
+#define GPI_SCRATCH1     (0x23404u + GPI_N)
+
+/* The words of a channel or event ring context. */
+#define CTX_CONFIG       0x00u
+#define CTX_LEN          0x04u
+#define CTX_BASE_LO      0x08u
+#define CTX_BASE_HI      0x0cu
+#define CTX_RP_LO        0x10u
+#define CTX_WP_LO        0x18u
+#define CTX_INT_MOD      0x20u
+#define CTX_MSI_LO       0x28u
+#define CTX_MSI_HI       0x2cu
+#define CTX_RPU_LO       0x30u
+#define CTX_RPU_HI       0x34u
+#define CTX_STATE(v)     (((v) >> 20) & 0xfu)
+
+#define GPI_CMD_ALLOC    0u
+#define GPI_CMD_START    1u
+#define GPI_CMD_STOP     2u
+#define GPI_CMD_RESET    9u
+#define GPI_CMD_DEALLOC  10u
+#define GPI_PROTO_SPI    1u
+#define GPI_EL_SIZE      16u
+#define GPI_RING_EL      64u
+#define GPI_RING_LEN     (GPI_EL_SIZE * GPI_RING_EL)
+
+/* Transfer ring elements (TREs) and the events. */
+#define TRE_TYPE(t)      ((uint32_t)(t) << 16)
+#define TRE_DMA          0x10u
+#define TRE_GO           0x20u
+#define TRE_CONFIG0      0x22u
+#define TRE_CHAIN        (1u << 0)
+#define TRE_IEOT         (1u << 9)
+#define TRE_LINK         (1u << 11)
+#define TRE_C0_TX_PACK   (1u << 24)
+#define TRE_C0_RX_PACK   (1u << 25)
+#define SPI_GO_TX        1u
+#define SPI_GO_DUPLEX    3u
+#define EV_XFER_COMPLETE 0x22u
+#define EV_CODE_EOT      2u
+
+/* One page of DMA memory: both transfer rings, the event ring, buffers. */
+#define GPI_DMA_SIZE     0x4000u
+#define GPI_TX_RING      0x0000u
+#define GPI_RX_RING      0x0400u
+#define GPI_EV_RING      0x0800u
+#define GPI_TX_BUF       0x0c00u
+#define GPI_RX_BUF       0x0e00u
+
+/*
+ * The apps SMMU. The GPI masters with stream id 0xf6 (its iommus cell);
+ * Android translates it, so before DMA with physical addresses the stream
+ * has to bypass. Only this one stream's mapping is changed here.
+ */
+#define SMMU_PA          0x0c600000u
+#define SMMU_LEN         0x00001000u
+#define SMMU_SCR0        0x000u
+#define SMMU_IDR0        0x020u
+#define SMMU_IDR1        0x024u
+#define SMMU_SMR(i)      (0x800u + 4u * (i))
+#define SMMU_S2CR(i)     (0xc00u + 4u * (i))
+#define SMMU_SCTLR_M     (1u << 0)
+#define SMMU_GFSR        0x048u
+#define SMMU_CB_FSR      0x058u
+#define SMMU_CB_FAR      0x060u
+#define SCR0_CLIENTPD    (1u << 0)
+#define SCR0_EXIDENABLE  (1u << 3)
+#define SCR0_USFCFG      (1u << 10)
+#define S2CR_TYPE(v)     (((v) >> 16) & 3u)
+#define S2CR_BYPASS      (1u << 16)
+#define S2CR_EXIDVALID   (1u << 10)
+#define SMR_VALID        (1u << 31)
+#define GPI_SID          0xf6u
+
+static struct {
+	vm_offset_t geni, tlmm, gcc;
+	bool dead;
+	uint32_t tx_depth, tx_width, rx_depth, rx_width;
+	uint32_t irq_last;
+	uint32_t fw, status, pin_cfg[11];
+	uint32_t active;
+	int x[FTS_MAX_TOUCH], y[FTS_MAX_TOUCH];
+	/* What the transport saw, repeated later so a photo can catch it. */
+	int clk;                     /* -1 not tried, 0 withheld, 1 ready */
+	uint32_t gcc_vote, gcc_se0;
+	int id_err;                  /* -1 not tried */
+	uint8_t raw[8];              /* the first reply bytes of the last read */
+	uint8_t id[4];               /* the id pair and its CRC */
+	uint32_t ifdis, cgc;          /* GENI_IF_DISABLE_RO and CGC_CTRL before init */
+	uint32_t snap[6];             /* status, m_irq, tx_fifo, rx_fifo, ios, clk_cfg */
+	/* The GSI path. */
+	bool gsi;
+	vm_offset_t gpi, smmu, dma;
+	uint64_t dma_pa;
+	unsigned wp[2], ev_rp, ev_wp;
+	char smmu_mode, gpi_stage;    /* see fts_smmu() and fts_gpi_init() */
+	bool noirq;                   /* rainftsnoirq: GPII interrupts left masked */
+	int stop;                     /* rainftsstop: 1 after SMMU, 2 after GPI init, 3 after SE setup,
+	                               * 4 after one RX TRE fetch (no SPI clock),
+	                               * 5 after one TX CONFIG0 TRE with an EOT event,
+	                               * 6 after a TX-only SPI write with no event */
+	uint32_t flt[6];              /* sGFSR, CB FSR, CB FAR lo/hi, ch1 RP, ch1 config */
+	int smmu_idx;
+	uint32_t smmu_scr0, smmu_s2cr;
+	uint32_t smmu_idr1, smmu_smr, smmu_cbar, smmu_sctlr;
+	int smmu_cb;
+	uint32_t smmu_cbbase, smmu_sample_sctlr, smmu_sample_cbar;
+	unsigned smmu_referenced, smmu_mapped, smmu_busy;
+	int smmu_sample_cb;
+	uint32_t gpi_before[3];       /* ch0, ch1, ev context word 0 at entry */
+	uint32_t gsnap[8];            /* ch0, ch1, ev, ch0 rp, glob, gpii, err, type */
+	uint32_t xsnap[8];            /* ch0 wp, ch1 rp/wp, ev rp/wp, SE status, m_irq, ios */
+	uint32_t ev_last[2];          /* dword 2 and 3 of the last event */
+} st = { .clk = -1, .id_err = -1, .smmu_mode = '-', .gpi_stage = '-', .smmu_idx = -1, .smmu_cb = -1, .smmu_sample_cb = -1 };
+static int fts_sleep_chan;
+
+static uint32_t
+fts_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+fts_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+fts_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&fts_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* The poll loops use the kernel's delay(): assert_wait_deadline with a
+ * deadline in the past does not necessarily leave the thread runnable, and
+ * a thread that blocks there never finishes. */
+static void
+fts_pause(void)
+{
+	delay(1);
+}
+
+/* The TLMM configuration of one pin: function, pull, drive and direction.
+ *
+ * The layout is: the pull in bits [1:0], the function in bits [5:2], the
+ * drive strength in bits [8:6] (three bits, so 0 to 7) and the output
+ * enable in bit 9. A drive value of 8 would set the output enable
+ * instead, so it must stay below 8.
+ */
+static void
+fts_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = pin * FTS_TLMM_STRIDE;
+	uint32_t cfg = fts_rd(st.tlmm, off);
+	if (out) {
+		fts_wr(st.tlmm, off + 4u,
+		    (fts_rd(st.tlmm, off + 4u) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	fts_wr(st.tlmm, off, cfg);
+}
+
+/* Tell what the GENI block says about itself. */
+static void
+fts_survey(void)
+{
+	uint32_t fw = fts_rd(st.geni, SE_FW);
+	uint32_t htx = fts_rd(st.geni, SE_HW_TX);
+	uint32_t hrx = fts_rd(st.geni, SE_HW_RX);
+	uint32_t status = fts_rd(st.geni, SE_STATUS);
+	st.ifdis = fts_rd(st.geni, SE_IF_DISABLE);
+	uint32_t proto = (fw & FW_REV_PROTOCOL_MSK) >> FW_REV_PROTOCOL_SHFT;
+
+	st.tx_depth = (htx & TX_FIFO_DEPTH_MSK) >> TX_FIFO_DEPTH_SHFT;
+	st.tx_width = (htx & TX_FIFO_WIDTH_MSK) >> TX_FIFO_WIDTH_SHFT;
+	st.rx_depth = (hrx & RX_FIFO_DEPTH_MSK) >> RX_FIFO_DEPTH_SHFT;
+	st.rx_width = (hrx & RX_FIFO_WIDTH_MSK) >> RX_FIFO_WIDTH_SHFT;
+	st.fw = fw;
+	st.status = status;
+	printf("RAIN FTS: geni fw=%#x proto=%u status=%#x tx_fifo=%u/%u rx_fifo=%u/%u\n",
+	    fw, proto, status, st.tx_depth, st.tx_width, st.rx_depth, st.rx_width);
+	if (proto != PROTO_SPI) {
+		printf("RAIN FTS: GENI is not in SPI mode (proto=%u); the ABL firmware is not loaded\n", proto);
+	}
+	if (st.tx_width != 32 || st.rx_width != 32) {
+		printf("RAIN FTS: unexpected FIFO width, SPI needs 32 bit words\n");
+	}
+}
+
+/* Select the 19.2 MHz XO parent, enable only QUP0/SE0 clocks, and
+ * verify the voted branches before touching the serial sequencer. */
+static bool
+fts_clocks(void)
+{
+	uint32_t rcg = FTS_GCC_SE0_RCG;
+	uint32_t dfs = fts_rd(st.gcc, rcg + 0x14u);
+	st.clk = 0;
+	uint32_t cfg = fts_rd(st.gcc, rcg + (dfs & 1u ? 0x1cu : 4u));
+	printf("RAIN FTS: GCC before vote=%#x dfs=%#x cfg=%#x\n",
+	    fts_rd(st.gcc, FTS_GCC_VOTE), dfs, cfg);
+	if (dfs & 1u) {
+		if ((cfg & 0x371fu) != 1u) {
+			printf("RAIN FTS: DFS level 0 is not XO/1; SPI withheld\n");
+			return false;
+		}
+	} else {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		fts_wr(st.gcc, rcg + 4u, cfg);
+		fts_wr(st.gcc, rcg, fts_rd(st.gcc, rcg) | 1u);
+		unsigned n;
+		for (n = 0; n < 5000u && (fts_rd(st.gcc, rcg) & 1u); n++)
+			fts_pause();
+		if (n == 5000u) {
+			printf("RAIN FTS: SE0 RCG update timed out; SPI withheld\n");
+			return false;
+		}
+	}
+	fts_wr(st.gcc, FTS_GCC_VOTE,
+	    fts_rd(st.gcc, FTS_GCC_VOTE) | FTS_GCC_VOTE_MASK);
+	for (unsigned n = 0; n < 5000u; n++) {
+		if (!(fts_rd(st.gcc, FTS_GCC_SE0_CBCR) & (1u << 31)) &&
+		    !(fts_rd(st.gcc, FTS_GCC_CORE_CBCR) & (1u << 31))) {
+			st.gcc_vote = fts_rd(st.gcc, FTS_GCC_VOTE);
+			st.gcc_se0 = fts_rd(st.gcc, FTS_GCC_SE0_CBCR);
+			st.clk = 1;
+			printf("RAIN FTS: GCC ready vote=%#x se0=%#x\n",
+			    st.gcc_vote, st.gcc_se0);
+			return true;
+		}
+		fts_pause();
+	}
+	st.gcc_vote = fts_rd(st.gcc, FTS_GCC_VOTE);
+	st.gcc_se0 = fts_rd(st.gcc, FTS_GCC_SE0_CBCR);
+	printf("RAIN FTS: GCC branches halted; SPI withheld\n");
+	return false;
+}
+
+/* Put the serial engine into FIFO or GSI mode with the SPI parameters set. */
+static void
+fts_se_setup(uint32_t speed_div)
+{
+	uint32_t val;
+
+	/* An idle GENI engine is required before changing FIFO parameters. */
+	if (fts_rd(st.geni, SE_STATUS) & 1u) {
+		printf("RAIN FTS: GENI command still active; SPI withheld\n");
+		st.dead = true;
+		return;
+	}
+	st.cgc = fts_rd(st.geni, SE_CGC_CTRL);
+	fts_wr(st.geni, SE_CGC_CTRL, st.cgc | DEFAULT_CGC_EN);
+	fts_wr(st.geni, SE_DMA_GEN_CFG, fts_rd(st.geni, SE_DMA_GEN_CFG) | DMA_GEN_CGC_ON);
+	fts_wr(st.geni, SE_OUTPUT_CTRL, DEFAULT_IO_OUTPUT);
+	fts_wr(st.geni, SE_FORCE_DEFAULT, 1u);
+	fts_wr(st.geni, SE_IRQ_CLR, 0xffffffffu);
+	if (st.gsi) {
+		/*
+		 * geni_se_select_gpi_mode: no engine interrupts, the DMA mode on
+		 * and the GSI events enabled. The word length, the packing and the
+		 * clock come with each transfer's CONFIG0 TRE.
+		 */
+		fts_wr(st.geni, SE_IRQ_ROUTE, 0);
+		fts_wr(st.geni, SE_IRQ_EN, fts_rd(st.geni, SE_IRQ_EN) &
+		    ~(M_CMD_DONE_EN | M_TX_FIFO_WM_EN | M_RX_FIFO_WM_EN | M_RX_FIFO_LAST_EN));
+		fts_wr(st.geni, SE_DMA_MODE, 1u);
+		fts_wr(st.geni, SE_GSI_EVENT_EN, fts_rd(st.geni, SE_GSI_EVENT_EN) | 0xfu);
+		fts_wr(st.geni, SE_SPI_TRANS_CFG, 0);
+		return;
+	}
+	fts_wr(st.geni, SE_GSI_EVENT_EN, 0);
+	fts_wr(st.geni, SE_IRQ_ROUTE, (fts_rd(st.geni, SE_IRQ_ROUTE) & ~DMA_IRQ_ROUTE) |
+	    GENI_M_IRQ_ROUTE | GENI_S_IRQ_ROUTE);
+	fts_wr(st.geni, SE_DMA_MODE, fts_rd(st.geni, SE_DMA_MODE) & ~1u);
+	fts_wr(st.geni, SE_RX_WM, 0);
+	fts_wr(st.geni, SE_RX_RFR_WM, st.rx_depth - 2u);
+
+	/* The SPI parameters: mode 0, chip select 0, eight bit words. */
+	fts_wr(st.geni, SE_SPI_LOOPBACK, 0);
+	fts_wr(st.geni, SE_SPI_DEMUX_SEL, 0);
+	fts_wr(st.geni, SE_SPI_CPHA, 0);
+	fts_wr(st.geni, SE_SPI_CPOL, 0);
+	fts_wr(st.geni, SE_SPI_DEMUX_INV, 0);
+	fts_wr(st.geni, SE_SPI_TRANS_CFG, 0);
+	fts_wr(st.geni, SE_SPI_WORD_LEN, 8u - 4u);
+	fts_wr(st.geni, SE_SPI_DELAY, 0);
+
+	/* The packing: eight bit words, four per FIFO word, MSB first. */
+	fts_wr(st.geni, SE_PACK0_TX, SE_PACK0);
+	fts_wr(st.geni, SE_PACK1_TX, SE_PACK1);
+	fts_wr(st.geni, SE_PACK0_RX, SE_PACK0);
+	fts_wr(st.geni, SE_PACK1_RX, SE_PACK1);
+
+	/* The serial engine clock: the divider and the clock enable. */
+	fts_wr(st.geni, SE_CLK_SEL, 0);
+	fts_wr(st.geni, SE_MCLK, (speed_div << 4) | 1u);
+
+	/* The interrupts the FIFO transfer needs. */
+	val = fts_rd(st.geni, SE_IRQ_EN);
+	val |= M_CMD_DONE_EN | M_TX_FIFO_WM_EN | M_RX_FIFO_WM_EN | M_RX_FIFO_LAST_EN;
+	fts_wr(st.geni, SE_IRQ_EN, val);
+}
+
+static void
+fts_snapshot(void)
+{
+	st.snap[0] = fts_rd(st.geni, SE_STATUS);
+	st.snap[1] = fts_rd(st.geni, SE_IRQ);
+	st.snap[2] = fts_rd(st.geni, SE_TX_COUNT);
+	st.snap[3] = fts_rd(st.geni, SE_RX_COUNT);
+	st.snap[4] = fts_rd(st.geni, SE_IOS);
+	st.snap[5] = fts_rd(st.geni, SE_MCLK);
+}
+
+static uint32_t
+gpi_rd(uint32_t off)
+{
+	return fts_rd(st.gpi, off - GPI_EE_OFF);
+}
+
+static void
+gpi_wr(uint32_t off, uint32_t val)
+{
+	fts_wr(st.gpi, off - GPI_EE_OFF, val);
+}
+
+static void
+gpi_rmw(uint32_t off, uint32_t mask, uint32_t val)
+{
+	gpi_wr(off, (gpi_rd(off) & ~mask) | (val & mask));
+}
+
+static void
+gpi_snapshot(void)
+{
+	st.gsnap[0] = gpi_rd(GPI_CH_CNTXT(0) + CTX_CONFIG);
+	st.gsnap[1] = gpi_rd(GPI_CH_CNTXT(1) + CTX_CONFIG);
+	st.gsnap[2] = gpi_rd(GPI_EV_CNTXT + CTX_CONFIG);
+	st.gsnap[3] = gpi_rd(GPI_CH_CNTXT(0) + CTX_RP_LO);
+	st.gsnap[4] = gpi_rd(GPI_GLOB_STTS);
+	st.gsnap[5] = gpi_rd(GPI_GPII_STTS);
+	st.gsnap[6] = gpi_rd(GPI_ERROR_LOG);
+	st.gsnap[7] = gpi_rd(GPI_TYPE_IRQ);
+	/* The doorbells land in the context WP; the serial engine shows a GO. */
+	st.xsnap[0] = gpi_rd(GPI_CH_CNTXT(0) + CTX_WP_LO);
+	st.xsnap[1] = gpi_rd(GPI_CH_CNTXT(1) + CTX_RP_LO);
+	st.xsnap[2] = gpi_rd(GPI_CH_CNTXT(1) + CTX_WP_LO);
+	st.xsnap[3] = gpi_rd(GPI_EV_CNTXT + CTX_RP_LO);
+	st.xsnap[4] = gpi_rd(GPI_EV_CNTXT + CTX_WP_LO);
+	st.xsnap[5] = fts_rd(st.geni, SE_STATUS);
+	st.xsnap[6] = fts_rd(st.geni, SE_IRQ);
+	st.xsnap[7] = fts_rd(st.geni, SE_IOS);
+}
+
+/*
+ * Some Qualcomm firmware substitutes FAULT for a BYPASS S2CR write.
+ * Linux's qcom_smmu_write_s2cr uses a disabled context bank configured
+ * for stage-1 translation / stage-2 bypass instead. Restrict that quirk
+ * to the GPI's exact SID, including a slot just reserved for it; never
+ * repoint a masked/shared SMR or a context bank used by another stream.
+ * An unused bank is disabled when SCTLR.M is clear; other bits may remain
+ * set from firmware. Clear the whole SCTLR and verify before routing DMA.
+ */
+static bool
+fts_smmu_bypass_quirk(unsigned idx, unsigned n, bool exids)
+{
+	uint32_t id1 = fts_rd(st.smmu, SMMU_IDR1);
+	unsigned pgshift = (id1 & (1u << 31)) ? 16u : 12u;
+	unsigned pgsize = 1u << pgshift;
+	unsigned cbbase = (1u << (((id1 >> 28) & 7u) + 1u)) << pgshift;
+	unsigned ncb = id1 & 0xffu, ns2cb = (id1 >> 16) & 0xffu;
+	vm_offset_t gr1;
+
+	st.smmu_idr1 = id1;
+	st.smmu_cbbase = cbbase;
+	st.smmu_smr = fts_rd(st.smmu, SMMU_SMR(idx));
+	if ((st.smmu_smr & (exids ? 0xffffu : 0x7fffu)) != GPI_SID ||
+	    ((st.smmu_smr >> 16) & (exids ? 0xffffu : 0x7fffu)) != 0 ||
+	    (!exids && !(st.smmu_smr & SMR_VALID)) ||
+	    (exids && !(st.smmu_s2cr & S2CR_EXIDVALID)) ||
+	    !ncb || ncb > 128u || ns2cb >= ncb ||
+	    cbbase >= 0x80000u || pgsize > 0x80000u - cbbase) {
+		st.smmu_mode = 'X';
+		return false;
+	}
+	gr1 = ml_io_map(SMMU_PA + pgsize, pgsize);
+	if (!gr1) {
+		st.smmu_mode = 'M';
+		return false;
+	}
+	for (int cb = (int)ncb - 1; cb >= (int)ns2cb; cb--) {
+		vm_offset_t cbpage;
+		unsigned off = cbbase + (unsigned)cb * pgsize;
+		bool referenced = false;
+		uint32_t old_cbar, old_s2cr, sctlr;
+
+		if (off > 0x80000u - pgsize)
+			continue;
+		for (unsigned j = 0; j < n; j++) {
+			uint32_t smr = fts_rd(st.smmu, SMMU_SMR(j));
+			uint32_t s2cr = fts_rd(st.smmu, SMMU_S2CR(j));
+			bool valid = exids ? (s2cr & S2CR_EXIDVALID) != 0 :
+			    (smr & SMR_VALID) != 0;
+			if (valid && S2CR_TYPE(s2cr) == 0 &&
+			    (s2cr & 0xffu) == (unsigned)cb) {
+				referenced = true;
+				break;
+			}
+		}
+		if (referenced) {
+			st.smmu_referenced++;
+			continue;
+		}
+		cbpage = ml_io_map(SMMU_PA + off, pgsize);
+		if (!cbpage) {
+			st.smmu_mode = 'M';
+			return false;
+		}
+		sctlr = fts_rd(cbpage, 0);
+		st.smmu_mapped++;
+		if (st.smmu_sample_cb < 0) {
+			st.smmu_sample_cb = cb;
+			st.smmu_sample_sctlr = sctlr;
+			st.smmu_sample_cbar = fts_rd(gr1, (unsigned)cb * 4u);
+		}
+		if (sctlr & SMMU_SCTLR_M) {
+			st.smmu_busy++;
+			continue;
+		}
+		old_cbar = fts_rd(gr1, (unsigned)cb * 4u);
+		old_s2cr = fts_rd(st.smmu, SMMU_S2CR(idx));
+		st.smmu_cb = cb;
+		fts_wr(cbpage, 0, 0);
+		st.smmu_sctlr = fts_rd(cbpage, 0);
+		if (st.smmu_sctlr != 0) {
+			fts_wr(cbpage, 0, sctlr);
+			st.smmu_mode = 'D';
+			return false;
+		}
+		fts_wr(gr1, (unsigned)cb * 4u, 1u << 16);
+		st.smmu_cbar = fts_rd(gr1, (unsigned)cb * 4u);
+		if ((st.smmu_cbar & (3u << 16)) != (1u << 16)) {
+			fts_wr(gr1, (unsigned)cb * 4u, old_cbar);
+			fts_wr(cbpage, 0, sctlr);
+			st.smmu_mode = 'C';
+			return false;
+		}
+		fts_wr(st.smmu, SMMU_S2CR(idx), (uint32_t)cb |
+		    (exids ? S2CR_EXIDVALID : 0));
+		st.smmu_s2cr = fts_rd(st.smmu, SMMU_S2CR(idx));
+		if (S2CR_TYPE(st.smmu_s2cr) == 0 &&
+		    (st.smmu_s2cr & 0xffu) == (unsigned)cb) {
+			st.smmu_mode = 'Q';
+			return true;
+		}
+		fts_wr(st.smmu, SMMU_S2CR(idx), old_s2cr);
+		fts_wr(gr1, (unsigned)cb * 4u, old_cbar);
+		fts_wr(cbpage, 0, sctlr);
+		st.smmu_mode = 'W';
+		return false;
+	}
+	st.smmu_mode = 'N';
+	return false;
+}
+
+/*
+ * Decide whether the GPI's stream can reach memory by physical address.
+ * smmu_mode: P SMMU off, B matched bypass, U unmatched bypass, T matched
+ * translate, F matched fault, u unmatched fault, b bypass programmed here,
+ * N no free stream/context bank, W the bypass did not stick, X shared SID,
+ * M mapping failure, D SCTLR clear failed, C context bank setup failed,
+ * Q Qualcomm bypass quirk.
+ */
+static bool
+fts_smmu(void)
+{
+	uint32_t scr0 = fts_rd(st.smmu, SMMU_SCR0);
+	unsigned n = fts_rd(st.smmu, SMMU_IDR0) & 0xffu, free_i = n, i;
+	bool exids = (scr0 & SCR0_EXIDENABLE) != 0;
+	int allow = 0;
+
+	st.smmu_scr0 = scr0;
+	if (scr0 & SCR0_CLIENTPD) {
+		st.smmu_mode = 'P';
+		return true;
+	}
+	if (n > 128u) {
+		n = 128u;
+		free_i = n;
+	}
+	for (i = 0; i < n; i++) {
+		uint32_t smr = fts_rd(st.smmu, SMMU_SMR(i));
+		uint32_t s2cr = fts_rd(st.smmu, SMMU_S2CR(i));
+		bool valid = exids ? (s2cr & S2CR_EXIDVALID) != 0 : (smr & SMR_VALID) != 0;
+		uint32_t id = exids ? (smr & 0xffffu) : (smr & 0x7fffu);
+		uint32_t mask = exids ? (smr >> 16) : ((smr >> 16) & 0x7fffu);
+
+		if (!valid) {
+			if (free_i == n) {
+				free_i = i;
+			}
+			continue;
+		}
+		if (((id ^ GPI_SID) & ~mask & 0xffffu) == 0) {
+			st.smmu_idx = (int)i;
+			st.smmu_s2cr = s2cr;
+			break;
+		}
+	}
+	if (st.smmu_idx >= 0) {
+		switch (S2CR_TYPE(st.smmu_s2cr)) {
+		case 1:
+			st.smmu_mode = 'B';
+			return true;
+		case 0:
+			st.smmu_mode = 'T';
+			break;
+		default:
+			st.smmu_mode = 'F';
+			break;
+		}
+	} else if (!(scr0 & SCR0_USFCFG)) {
+		st.smmu_mode = 'U';
+		return true;
+	} else {
+		st.smmu_mode = 'u';
+	}
+
+	/* Changing the SMMU needs consent: rainftssmmu=1. */
+	PE_parse_boot_argn("rainftssmmu", &allow, sizeof(allow));
+	if (!allow) {
+		return false;
+	}
+	if (st.smmu_idx >= 0) {
+		i = (unsigned)st.smmu_idx;
+	} else if (free_i < n) {
+		i = free_i;
+	} else {
+		st.smmu_mode = 'N';
+		return false;
+	}
+	/* arm_smmu_write_sme order: the S2CR first, then the valid SMR. */
+	fts_wr(st.smmu, SMMU_S2CR(i), S2CR_BYPASS | (exids ? S2CR_EXIDVALID : 0));
+	if (st.smmu_idx < 0) {
+		fts_wr(st.smmu, SMMU_SMR(i), exids ? GPI_SID : (SMR_VALID | GPI_SID));
+	}
+	st.smmu_idx = (int)i;
+	st.smmu_s2cr = fts_rd(st.smmu, SMMU_S2CR(i));
+	if (S2CR_TYPE(st.smmu_s2cr) != 1u) {
+		st.smmu_mode = 'W';
+		return S2CR_TYPE(st.smmu_s2cr) == 2u &&
+		    fts_smmu_bypass_quirk(i, n, exids);
+	}
+	if ((fts_rd(st.smmu, SMMU_SMR(i)) & 0xffffu) != GPI_SID) {
+		st.smmu_mode = 'X';
+		return false;
+	}
+	st.smmu_mode = 'b';
+	return true;
+}
+
+/* Send a GPII command and poll the context until it reaches a state. */
+static int
+gpi_cmd(uint32_t reg, uint32_t cmd, uint32_t ctx, int want)
+{
+	gpi_wr(reg, cmd);
+	for (unsigned n = 0; n < 250u; n++) {
+		uint32_t s = CTX_STATE(gpi_rd(ctx + CTX_CONFIG));
+		if (want < 0 || s == (uint32_t)want) {
+			gpi_wr(GPI_SRC_CH_CLR, gpi_rd(GPI_SRC_CH_IRQ));
+			gpi_wr(GPI_SRC_EV_CLR, gpi_rd(GPI_SRC_EV_IRQ));
+			return 0;
+		}
+		fts_sleep(1);
+	}
+	return ETIMEDOUT;
+}
+
+/*
+ * Bring up GPII 0 the way gpi_ch_init does: interrupts configured (they
+ * are polled here, never taken), the event ring, then the TX and RX
+ * channels allocated and started. gpi_stage tells how far it got:
+ * m no memory, s SMMU refused, r reset of a used GPII failed,
+ * e event ring, 0/1 channel allocate, 2/3 channel start, k ready,
+ * S stopped after the SMMU step (rainftsstop=1).
+ */
+static bool
+fts_gpi_init(void)
+{
+	uint64_t pa;
+
+	st.gpi = ml_io_map(GPI_PA, GPI_LEN);
+	st.smmu = ml_io_map(SMMU_PA, SMMU_LEN);
+	if (st.gpi == 0 || st.smmu == 0) {
+		st.gpi_stage = 'm';
+		return false;
+	}
+	if (kmem_alloc_contig(kernel_map, &st.dma, GPI_DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		st.gpi_stage = 'm';
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)st.dma);
+	if (!pn) {
+		st.gpi_stage = 'm';
+		return false;
+	}
+	st.dma_pa = ptoa_64(pn);
+	if (!fts_smmu()) {
+		st.gpi_stage = 's';
+		return false;
+	}
+	/* rainftsstop=1 isolates the SMMU change from any GPI access. */
+	if (st.stop == 1) {
+		st.gpi_stage = 'S';
+		return false;
+	}
+
+	st.gpi_before[0] = gpi_rd(GPI_CH_CNTXT(0) + CTX_CONFIG);
+	st.gpi_before[1] = gpi_rd(GPI_CH_CNTXT(1) + CTX_CONFIG);
+	st.gpi_before[2] = gpi_rd(GPI_EV_CNTXT + CTX_CONFIG);
+	/* Nothing should own GPII 0 before the kernel; undo it if something did. */
+	for (unsigned k = 0; k < 2u; k++) {
+		uint32_t s = CTX_STATE(st.gpi_before[k]);
+		if (s == 0) {
+			continue;
+		}
+		if (s == 2u &&
+		    gpi_cmd(GPI_CH_CMD, (GPI_CMD_STOP << 24) | k, GPI_CH_CNTXT(k), 3)) {
+			st.gpi_stage = 'r';
+			return false;
+		}
+		if (gpi_cmd(GPI_CH_CMD, (GPI_CMD_RESET << 24) | k, GPI_CH_CNTXT(k), 1) ||
+		    gpi_cmd(GPI_CH_CMD, (GPI_CMD_DEALLOC << 24) | k, GPI_CH_CNTXT(k), -1)) {
+			st.gpi_stage = 'r';
+			return false;
+		}
+	}
+	if (CTX_STATE(st.gpi_before[2]) != 0 &&
+	    (gpi_cmd(GPI_EV_CMD, GPI_CMD_RESET << 24, GPI_EV_CNTXT, -1) ||
+	    gpi_cmd(GPI_EV_CMD, GPI_CMD_DEALLOC << 24, GPI_EV_CNTXT, -1))) {
+		st.gpi_stage = 'r';
+		return false;
+	}
+
+	/*
+	 * gpi_config_interrupts(DEFAULT_IRQ_SETTINGS), unless rainftsnoirq=1:
+	 * this driver polls the event ring and installs no handler, so the
+	 * GPII line can stay masked. The event ring is written either way.
+	 */
+	int noirq = 0;
+	PE_parse_boot_argn("rainftsnoirq", &noirq, sizeof(noirq));
+	st.noirq = noirq != 0;
+	uint32_t on = st.noirq ? 0 : ~0u;
+	gpi_rmw(GPI_TYPE_IRQ_MSK, 0x7fu, 0x4fu & on);
+	gpi_rmw(GPI_IEOB_MSK, 1u, 1u & on);
+	gpi_rmw(GPI_SRC_CH_MSK, 3u, 3u & on);
+	gpi_rmw(GPI_SRC_EV_MSK, 1u, 1u & on);
+	gpi_rmw(GPI_GLOB_EN, 0xfu, 0xfu & on);
+	gpi_rmw(GPI_GPII_EN, 0xfu, 0xfu & on);
+	gpi_wr(GPI_MSI_LSB, 0);
+	gpi_wr(GPI_MSI_MSB, 0);
+	gpi_wr(GPI_SCRATCH0, 0);
+	gpi_wr(GPI_SCRATCH1, 0);
+	gpi_rmw(GPI_INTSET, 1u, 1u);
+	gpi_wr(GPI_ERROR_LOG, 0);
+
+	/* The event ring: allocate, then program its context. */
+	if (gpi_cmd(GPI_EV_CMD, GPI_CMD_ALLOC << 24, GPI_EV_CNTXT, 1)) {
+		st.gpi_stage = 'e';
+		gpi_snapshot();
+		return false;
+	}
+	pa = st.dma_pa + GPI_EV_RING;
+	gpi_wr(GPI_EV_CNTXT + CTX_CONFIG, (GPI_EL_SIZE << 24) | (1u << 16) | 2u);
+	gpi_wr(GPI_EV_CNTXT + CTX_LEN, GPI_RING_LEN);
+	gpi_wr(GPI_EV_CNTXT + CTX_BASE_LO, (uint32_t)pa);
+	gpi_wr(GPI_EV_CNTXT + CTX_BASE_HI, (uint32_t)(pa >> 32));
+	gpi_wr(GPI_EV_DB + 4u, (uint32_t)(pa >> 32));
+	gpi_wr(GPI_EV_CNTXT + CTX_INT_MOD, 0);
+	gpi_wr(GPI_EV_CNTXT + CTX_MSI_LO, 0);
+	gpi_wr(GPI_EV_CNTXT + CTX_MSI_HI, 0);
+	gpi_wr(GPI_EV_CNTXT + CTX_RPU_LO, 0);
+	gpi_wr(GPI_EV_CNTXT + CTX_RPU_HI, 0);
+	flush_dcache64((addr64_t)st.dma_pa, GPI_DMA_SIZE, TRUE);
+	st.ev_rp = 0;
+	st.ev_wp = GPI_RING_EL - 1u;
+	gpi_wr(GPI_EV_DB, (uint32_t)(pa + st.ev_wp * GPI_EL_SIZE));
+
+	/* The channels: 0 transmits (direction out), 1 receives. */
+	for (unsigned k = 0; k < 2u; k++) {
+		if (gpi_cmd(GPI_CH_CMD, (GPI_CMD_ALLOC << 24) | k, GPI_CH_CNTXT(k), 1)) {
+			st.gpi_stage = (char)('0' + k);
+			gpi_snapshot();
+			return false;
+		}
+		pa = st.dma_pa + (k ? GPI_RX_RING : GPI_TX_RING);
+		gpi_wr(GPI_CH_CNTXT(k) + CTX_CONFIG,
+		    (GPI_EL_SIZE << 24) | ((k == 0 ? 1u : 0u) << 3) | 2u);
+		gpi_wr(GPI_CH_CNTXT(k) + CTX_LEN, GPI_RING_LEN);
+		gpi_wr(GPI_CH_CNTXT(k) + CTX_BASE_LO, (uint32_t)pa);
+		gpi_wr(GPI_CH_CNTXT(k) + CTX_BASE_HI, (uint32_t)(pa >> 32));
+		gpi_wr(GPI_CH_DB(k) + 4u, (uint32_t)(pa >> 32));
+		gpi_wr(GPI_CH_SCRATCH(k, 0),
+		    ((k ^ 1u) << 16) | (GPI_PROTO_SPI << 4) | 0u /* SE 0 */);
+		gpi_wr(GPI_CH_SCRATCH(k, 1), 0);
+		gpi_wr(GPI_CH_SCRATCH(k, 2), 0);
+		gpi_wr(GPI_CH_SCRATCH(k, 3), 0);
+		gpi_wr(GPI_CH_QOS(k), 1);
+		st.wp[k] = 0;
+	}
+	for (unsigned k = 0; k < 2u; k++) {
+		if (gpi_cmd(GPI_CH_CMD, (GPI_CMD_START << 24) | k, GPI_CH_CNTXT(k), 2)) {
+			st.gpi_stage = (char)('2' + k);
+			gpi_snapshot();
+			return false;
+		}
+	}
+	st.gpi_stage = 'k';
+	gpi_snapshot();
+	return true;
+}
+
+static void
+gpi_put(unsigned k, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	volatile uint32_t *tre = (volatile uint32_t *)(st.dma +
+	    (k ? GPI_RX_RING : GPI_TX_RING) + st.wp[k] * GPI_EL_SIZE);
+	tre[0] = d0;
+	tre[1] = d1;
+	tre[2] = d2;
+	tre[3] = d3;
+	st.wp[k] = (st.wp[k] + 1u) % GPI_RING_EL;
+}
+
+/*
+ * One full duplex transfer through the GPI, as gpi_create_spi_tre builds
+ * it: the RX channel gets a DMA TRE, the TX channel CONFIG0 (8 bit words,
+ * packed, mode 0, XO / 4), GO (duplex, chip select 0) and a DMA TRE that
+ * asks for the end-of-transfer event.
+ */
+static int
+gpi_xfer(const uint8_t *tx, unsigned len, uint8_t *rx)
+{
+	uint8_t *txb = (uint8_t *)(st.dma + GPI_TX_BUF);
+	uint8_t *rxb = (uint8_t *)(st.dma + GPI_RX_BUF);
+	uint64_t ev = st.dma_pa + GPI_EV_RING;
+	bool done = false;
+	uint32_t code = 0;
+
+	if (len == 0 || len > 0x200u) {
+		return EIO;
+	}
+	memcpy(txb, tx, len);
+	memset(rxb, 0, len);
+	gpi_put(1, (uint32_t)(st.dma_pa + GPI_RX_BUF), (uint32_t)((st.dma_pa + GPI_RX_BUF) >> 32),
+	    len, TRE_TYPE(TRE_DMA));
+	gpi_put(0, 8u - 4u /* word length */ | TRE_C0_TX_PACK | TRE_C0_RX_PACK, 0,
+	    4u /* clk_div */ | (0u << 16) /* clk_src: DFS level 0, XO */,
+	    TRE_TYPE(TRE_CONFIG0) | TRE_CHAIN);
+	gpi_put(0, SPI_GO_DUPLEX | (0u << 8) /* cs */, 0, 0,
+	    TRE_TYPE(TRE_GO) | TRE_CHAIN | TRE_LINK);
+	gpi_put(0, (uint32_t)(st.dma_pa + GPI_TX_BUF), (uint32_t)((st.dma_pa + GPI_TX_BUF) >> 32),
+	    len, TRE_TYPE(TRE_DMA) | TRE_IEOT);
+	flush_dcache64((addr64_t)st.dma_pa, GPI_DMA_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpi_wr(GPI_CH_DB(1), (uint32_t)(st.dma_pa + GPI_RX_RING + st.wp[1] * GPI_EL_SIZE));
+	gpi_wr(GPI_CH_DB(0), (uint32_t)(st.dma_pa + GPI_TX_RING + st.wp[0] * GPI_EL_SIZE));
+
+	for (unsigned t = 0; t < 200u && !done; t++) {
+		uint32_t hw = gpi_rd(GPI_EV_CNTXT + CTX_RP_LO);
+		unsigned idx = ((hw - (uint32_t)ev) / GPI_EL_SIZE) % GPI_RING_EL;
+
+		while (st.ev_rp != idx) {
+			volatile uint32_t *e = (volatile uint32_t *)(st.dma + GPI_EV_RING +
+			    st.ev_rp * GPI_EL_SIZE);
+			flush_dcache64((addr64_t)(ev + st.ev_rp * GPI_EL_SIZE), GPI_EL_SIZE, TRUE);
+			st.ev_last[0] = e[2];
+			st.ev_last[1] = e[3];
+			if (((e[3] >> 16) & 0xffu) == EV_XFER_COMPLETE && (e[3] >> 24) == 0) {
+				done = true;
+				code = e[2] >> 24;
+			}
+			st.ev_rp = (st.ev_rp + 1u) % GPI_RING_EL;
+			st.ev_wp = (st.ev_wp + 1u) % GPI_RING_EL;
+		}
+		gpi_wr(GPI_EV_DB, (uint32_t)(ev + st.ev_wp * GPI_EL_SIZE));
+		gpi_wr(GPI_IEOB_CLR, 1u);
+		if (!done) {
+			fts_sleep(1);
+		}
+	}
+	if (!done) {
+		gpi_snapshot();
+		return ETIMEDOUT;
+	}
+	/* The RX DMA TRE has no event of its own: wait for its ring to drain. */
+	for (unsigned t = 0; t < 20u; t++) {
+		if (gpi_rd(GPI_CH_CNTXT(1) + CTX_RP_LO) ==
+		    (uint32_t)(st.dma_pa + GPI_RX_RING + st.wp[1] * GPI_EL_SIZE)) {
+			break;
+		}
+		fts_sleep(1);
+	}
+	flush_dcache64((addr64_t)(st.dma_pa + GPI_RX_BUF), len, TRUE);
+	if (rx != NULL) {
+		memcpy(rx, rxb, len);
+	}
+	if (code != EV_CODE_EOT) {
+		gpi_snapshot();
+		return EIO;
+	}
+	return 0;
+}
+
+/*
+ * rainftsstop=4: queue a single RX DMA TRE and ring only the RX doorbell.
+ * The GPI fetches the TRE from memory through the SMMU stream, but with no
+ * GO on the TX channel the serial engine never clocks SPI. Then read the
+ * SMMU global and context-bank fault registers.
+ */
+static void gpi_read_faults(void);
+static void gpi_txonly_probe(void);
+
+static void
+gpi_rx_fetch_probe(void)
+{
+	gpi_put(1, (uint32_t)(st.dma_pa + GPI_RX_BUF), (uint32_t)((st.dma_pa + GPI_RX_BUF) >> 32),
+	    16u, TRE_TYPE(TRE_DMA));
+	flush_dcache64((addr64_t)st.dma_pa, GPI_DMA_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("RAIN FTS: ringing the RX doorbell only\n");
+	fts_sleep(100);
+	gpi_wr(GPI_CH_DB(1), (uint32_t)(st.dma_pa + GPI_RX_RING + st.wp[1] * GPI_EL_SIZE));
+	fts_sleep(500);
+	gpi_read_faults();
+	printf("RAIN FTS: RX fetch survived gfsr=%#x fsr=%#x\n", st.flt[0], st.flt[1]);
+}
+
+/*
+ * rainftsstop=6: a TX-only SPI write (CONFIG0, GO TX, DMA) with no IEOT and
+ * no RX TRE. The GPI reads the TREs and the four header bytes and clocks
+ * them out, but writes nothing to memory: no RX data, no event. Whether
+ * it ran shows in the TX channel RP (xsnap/gsnap) and the SE status.
+ */
+static void
+gpi_txonly_probe(void)
+{
+	uint8_t *txb = (uint8_t *)(st.dma + GPI_TX_BUF);
+	static const uint8_t hdr[4] = { FTS_CHIP_ID_REG, FTS_READ_CMD, 0, 2 };
+
+	memcpy(txb, hdr, sizeof(hdr));
+	gpi_put(0, 8u - 4u /* word length */ | TRE_C0_TX_PACK | TRE_C0_RX_PACK, 0,
+	    4u /* clk_div */, TRE_TYPE(TRE_CONFIG0) | TRE_CHAIN);
+	gpi_put(0, SPI_GO_TX | (0u << 8) /* cs */, 0, 0,
+	    TRE_TYPE(TRE_GO) | TRE_CHAIN);
+	gpi_put(0, (uint32_t)(st.dma_pa + GPI_TX_BUF), (uint32_t)((st.dma_pa + GPI_TX_BUF) >> 32),
+	    sizeof(hdr), TRE_TYPE(TRE_DMA));
+	flush_dcache64((addr64_t)st.dma_pa, GPI_DMA_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("RAIN FTS: ringing the TX doorbell for a TX-only write\n");
+	fts_sleep(100);
+	gpi_wr(GPI_CH_DB(0), (uint32_t)(st.dma_pa + GPI_TX_RING + st.wp[0] * GPI_EL_SIZE));
+	fts_sleep(500);
+	gpi_read_faults();
+	printf("RAIN FTS: TX-only survived rp0=%#x se=%#x\n", st.gsnap[3], st.xsnap[5]);
+}
+
+/* The SMMU fault registers and the RX channel after a probe. */
+static void
+gpi_read_faults(void)
+{
+	uint32_t id1 = st.smmu_idr1;
+	unsigned pgsize = (id1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	vm_offset_t cbpage = 0;
+
+	st.flt[0] = fts_rd(st.smmu, SMMU_GFSR);
+	if (st.smmu_cb >= 0) {
+		cbpage = ml_io_map(SMMU_PA + st.smmu_cbbase + (unsigned)st.smmu_cb * pgsize, pgsize);
+	}
+	if (cbpage) {
+		st.flt[1] = fts_rd(cbpage, SMMU_CB_FSR);
+		st.flt[2] = fts_rd(cbpage, SMMU_CB_FAR);
+		st.flt[3] = fts_rd(cbpage, SMMU_CB_FAR + 4u);
+	}
+	st.flt[4] = gpi_rd(GPI_CH_CNTXT(1) + CTX_RP_LO);
+	st.flt[5] = gpi_rd(GPI_CH_CNTXT(1) + CTX_CONFIG);
+	gpi_snapshot();
+}
+
+/*
+ * rainftsstop=5: a lone CONFIG0 TRE on the TX channel, asking for the EOT
+ * event. The GPI reads the TRE, programs the serial engine and writes one
+ * event into the ring, all without a GO, so SPI is never clocked. This
+ * tests a GPI memory write (the event) apart from an SPI transfer.
+ */
+static void
+gpi_cfg_probe(void)
+{
+	uint64_t ev = st.dma_pa + GPI_EV_RING;
+
+	gpi_put(0, 8u - 4u /* word length */ | TRE_C0_TX_PACK | TRE_C0_RX_PACK, 0,
+	    4u /* clk_div */, TRE_TYPE(TRE_CONFIG0) | TRE_IEOT);
+	flush_dcache64((addr64_t)st.dma_pa, GPI_DMA_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("RAIN FTS: ringing the TX doorbell for CONFIG0 only\n");
+	fts_sleep(100);
+	gpi_wr(GPI_CH_DB(0), (uint32_t)(st.dma_pa + GPI_TX_RING + st.wp[0] * GPI_EL_SIZE));
+	for (unsigned t = 0; t < 500u; t++) {
+		uint32_t hw = gpi_rd(GPI_EV_CNTXT + CTX_RP_LO);
+		unsigned idx = ((hw - (uint32_t)ev) / GPI_EL_SIZE) % GPI_RING_EL;
+
+		if (idx != st.ev_rp) {
+			volatile uint32_t *e = (volatile uint32_t *)(st.dma + GPI_EV_RING +
+			    st.ev_rp * GPI_EL_SIZE);
+			flush_dcache64((addr64_t)(ev + st.ev_rp * GPI_EL_SIZE), GPI_EL_SIZE, TRUE);
+			st.ev_last[0] = e[2];
+			st.ev_last[1] = e[3];
+			break;
+		}
+		fts_sleep(1);
+	}
+	gpi_read_faults();
+	printf("RAIN FTS: CONFIG0 survived evt=%#x/%#x gfsr=%#x\n",
+	    st.ev_last[0], st.ev_last[1], st.flt[0]);
+}
+
+/* One full duplex SPI transfer. */
+static int
+fts_spi_xfer(const uint8_t *tx, unsigned txlen, uint8_t *rx, unsigned rxlen)
+{
+	unsigned sent = 0, got = 0;
+	uint32_t irq;
+
+	if (txlen > FTS_MAX_XFER || rxlen > FTS_MAX_XFER) {
+		return EIO;
+	}
+	if (st.gsi) {
+		return gpi_xfer(tx, txlen, rxlen ? rx : NULL);
+	}
+	fts_wr(st.geni, SE_IRQ_CLR, 0xffffffffu);
+	fts_wr(st.geni, SE_TX_WM, 0);
+	fts_wr(st.geni, SE_SPI_TX_LEN, txlen);
+	fts_wr(st.geni, SE_SPI_RX_LEN, rxlen);
+	/* The primary sequencer: transmit and receive at once. */
+	fts_wr(st.geni, SE_CMD, ((SPI_TX_ONLY | SPI_RX_ONLY) << M_OPCODE_SHFT));
+
+	/* Push the transmit words. The FIFO holds a few, so the rest follows
+	 * the watermark interrupt. */
+	while (sent < txlen) {
+		uint32_t word = 0;
+		unsigned n = txlen - sent;
+		if (n > 4) {
+			n = 4;
+		}
+		/* Never overrun the FIFO: drain it first when it is full. */
+		unsigned i;
+		for (i = 0; i < 2000; i++) {
+			if (!(fts_rd(st.geni, SE_TX_COUNT) & TX_FIFO_WC_MSK)) {
+				break;
+			}
+			fts_wr(st.geni, SE_TX_WM, 1u);
+			fts_pause();
+		}
+		if (i == 2000) {
+			fts_snapshot();
+			st.irq_last = st.snap[1];
+			fts_wr(st.geni, SE_CTRL, M_CMD_ABORT);
+			return ETIMEDOUT;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			word |= (uint32_t)tx[sent + i] << (8u * i);
+		}
+		fts_wr(st.geni, SE_TX, word);
+		sent += n;
+	}
+	fts_wr(st.geni, SE_TX_WM, 0);
+
+	/* Drain the receive FIFO until the transfer is done. */
+	for (unsigned i = 0; i < 20000; i++) {
+		uint32_t count = fts_rd(st.geni, SE_RX_COUNT) & RX_FIFO_WC_MSK;
+		while (count--) {
+			uint32_t word = fts_rd(st.geni, SE_RX);
+			if (rx == NULL) {
+				continue;
+			}
+			for (unsigned j = 0; j < 4 && got < rxlen; j++) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		irq = fts_rd(st.geni, SE_IRQ);
+		st.irq_last = irq;
+		if (irq & (M_CMD_OVERRUN | M_ILLEGAL_CMD | M_CMD_FAILURE)) {
+			fts_snapshot();
+			printf("RAIN FTS: SPI error irq=%#x status=%#x\n", irq,
+			    st.snap[0]);
+			fts_wr(st.geni, SE_IRQ_CLR, irq);
+			fts_wr(st.geni, SE_CTRL, M_CMD_ABORT);
+			fts_wr(st.geni, SE_IRQ_CLR, 0xffffffffu);
+			return EIO;
+		}
+		if (irq & M_CMD_DONE) {
+			fts_wr(st.geni, SE_IRQ_CLR, irq);
+			return got >= rxlen ? 0 : EIO;
+		}
+		fts_wr(st.geni, SE_IRQ_CLR, irq & (M_RX_FIFO_WM_EN | M_RX_FIFO_LAST_EN | M_TX_FIFO_WM_EN));
+		fts_pause();
+	}
+	fts_snapshot();
+	printf("RAIN FTS: SPI transfer timed out, irq=%#x status=%#x\n",
+	    st.irq_last, st.snap[0]);
+	fts_wr(st.geni, SE_CTRL, M_CMD_ABORT);
+	fts_wr(st.geni, SE_IRQ_CLR, 0xffffffffu);
+	return ETIMEDOUT;
+}
+
+/* The Focaltech framing: an address, a command, the length, three dummy
+ * bytes and the payload. The write path is reserved for the firmware loader,
+ * which comes with the report parser. */
+static int fts_write(const uint8_t *data, unsigned len) __unused;
+
+static int
+fts_write(const uint8_t *data, unsigned len)
+{
+	uint8_t buf[FTS_MAX_XFER];
+	unsigned total = FTS_HEADER_LEN + FTS_DUMMY_BYTES + len - 1u;
+
+	if (len < 2 || total > FTS_MAX_XFER) {
+		return EIO;
+	}
+	buf[0] = data[0];
+	buf[1] = FTS_WRITE_CMD;
+	buf[2] = (uint8_t)((len - 1u) >> 8);
+	buf[3] = (uint8_t)(len - 1u);
+	memset(&buf[4], 0, FTS_DUMMY_BYTES);
+	memcpy(&buf[FTS_HEADER_LEN + FTS_DUMMY_BYTES], &data[1], len - 1u);
+	return fts_spi_xfer(buf, total, NULL, 0);
+}
+
+/* A read returns the payload followed by its two CRC bytes. */
+static int
+fts_read(const uint8_t *cmd, unsigned cmdlen, uint8_t *data, unsigned len)
+{
+	uint8_t buf[FTS_MAX_XFER];
+	uint8_t reply[FTS_MAX_XFER];
+	unsigned total = FTS_HEADER_LEN + FTS_DUMMY_BYTES + len + 2u;
+	int error;
+
+	if (total > FTS_MAX_XFER || len == 0 || cmdlen == 0) {
+		return EIO;
+	}
+	buf[0] = cmd[0];
+	buf[1] = FTS_READ_CMD;
+	buf[2] = (uint8_t)(len >> 8);
+	buf[3] = (uint8_t)len;
+	memset(&buf[4], 0, total - FTS_HEADER_LEN);
+	memset(reply, 0, sizeof(reply));
+	error = fts_spi_xfer(buf, total, reply, total);
+	memcpy(st.raw, reply, sizeof(st.raw));
+	if (error) {
+		return error;
+	}
+	if (reply[3] & 0xa0u) {
+		printf("RAIN FTS: read addr=%02x status=%02x raw=%02x %02x %02x %02x\n",
+		    cmd[0], reply[3], reply[4], reply[5], reply[6], reply[7]);
+		return EIO;
+	}
+	memcpy(data, &reply[FTS_HEADER_LEN + FTS_DUMMY_BYTES], len + 2u);
+	return 0;
+}
+
+static uint16_t
+fts_crc(const uint8_t *data, unsigned len)
+{
+	uint16_t crc = 0xffff;
+	for (unsigned i = 0; i < len; i++) {
+		crc ^= data[i];
+		for (unsigned j = 0; j < 8; j++) {
+			crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0x8408u) : (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+/* The identity of the controller: the boot id register pair. */
+static void
+fts_probe_id(void)
+{
+	uint8_t cmd = FTS_CHIP_ID_REG;
+	uint8_t buf[16];
+	uint16_t calc, read;
+	int error;
+
+	memset(buf, 0, sizeof(buf));
+	error = fts_read(&cmd, 1, buf, 2);
+	st.id_err = error;
+	memcpy(st.id, buf, sizeof(st.id));
+	if (error) {
+		printf("RAIN FTS: chip id read failed: %d\n", error);
+		return;
+	}
+	calc = fts_crc(buf, 2);
+	read = (uint16_t)((buf[3] << 8) | buf[2]);
+	printf("RAIN FTS: boot id %02x %02x crc %04x/%04x\n", buf[0], buf[1], calc, read);
+	if (buf[0] == 0x86 && buf[1] == 0x32) {
+		printf("RAIN FTS: FT8006S answered\n");
+	} else {
+		printf("RAIN FTS: unexpected chip id\n");
+	}
+}
+
+static void
+fts_touch_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < FTS_MAX_TOUCH; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] ||
+			    y[id] != st.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+/* Read and parse one FT8006S touch frame from register 0x01. */
+static int
+fts_poll_touch(void)
+{
+	uint8_t cmd = FTS_TOUCH_REG;
+	uint8_t buf[FTS_TOUCH_LEN + 2u];
+	int x[FTS_MAX_TOUCH] = {0}, y[FTS_MAX_TOUCH] = {0};
+	uint32_t mask = 0, seen = 0;
+	uint16_t calc, recv;
+
+	int err = fts_read(&cmd, 1, buf, FTS_TOUCH_LEN);
+	if (err) {
+		return err;
+	}
+	calc = fts_crc(buf, FTS_TOUCH_LEN);
+	recv = (uint16_t)((buf[FTS_TOUCH_LEN + 1u] << 8) | buf[FTS_TOUCH_LEN]);
+	if (calc != recv) {
+		return EIO;
+	}
+	unsigned n = buf[1] & 0x0fu;
+	if (n > FTS_MAX_TOUCH) {
+		return EIO;
+	}
+	if (n == 0) {
+		fts_touch_report(0, st.x, st.y);
+		return 0;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 2u + 6u * i;
+		unsigned id = p[2] >> 4;
+		unsigned event = p[0] >> 6;
+		if (id >= FTS_MAX_TOUCH) {
+			break;
+		}
+		if (seen & (1u << id)) {
+			return EIO;
+		}
+		seen |= 1u << id;
+		if (event == 1u) {
+			continue;
+		}
+		unsigned px = ((unsigned)(p[0] & 0x0fu) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 0x0fu) << 8) | p[3];
+		if (px > 719 || py > 1649) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	fts_touch_report(mask, x, y);
+	return 0;
+}
+
+/*
+ * The console scrolls the one-shot lines away within seconds once the
+ * userland logs, so repeat what the transport saw every ten seconds for
+ * three minutes.
+ */
+static void
+fts_repeat(const char *stage)
+{
+	for (unsigned n = 0; n < 18; n++) {
+		fts_sleep(10000);
+		printf("RAIN FTS: %s clk=%d se0=%#x ifdis=%#x cgc=%#x id_err=%d id=%02x %02x crc=%02x%02x raw=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    stage, st.clk, st.gcc_se0, st.ifdis, st.cgc, st.id_err,
+		    st.id[0], st.id[1], st.id[3], st.id[2],
+		    st.raw[0], st.raw[1], st.raw[2], st.raw[3],
+		    st.raw[4], st.raw[5], st.raw[6], st.raw[7]);
+		if (!st.gsi) {
+			printf("RAIN FTS: %s snap status=%#x irq=%#x txf=%#x rxf=%#x ios=%#x mclk=%#x\n",
+			    stage, st.snap[0], st.snap[1], st.snap[2], st.snap[3],
+			    st.snap[4], st.snap[5]);
+			continue;
+		}
+		printf("RAIN FTS: %s gpi=%c smmu=%c scr0=%#x idx=%d s2cr=%#x pa=%#llx was=%#x/%#x/%#x\n",
+		    stage, st.gpi_stage, st.smmu_mode, st.smmu_scr0, st.smmu_idx,
+		    st.smmu_s2cr, (unsigned long long)st.dma_pa, st.gpi_before[0],
+		    st.gpi_before[1], st.gpi_before[2]);
+		printf("RAIN FTS: %s smmu id1=%#x smr=%#x cb=%d cbar=%#x sctlr=%#x\n",
+		    stage, st.smmu_idr1, st.smmu_smr, st.smmu_cb,
+		    st.smmu_cbar, st.smmu_sctlr);
+		printf("RAIN FTS: %s smmu scan base=%#x ref=%u map=%u busy=%u sample=%d/%#x/%#x\n",
+		    stage, st.smmu_cbbase, st.smmu_referenced, st.smmu_mapped,
+		    st.smmu_busy, st.smmu_sample_cb, st.smmu_sample_sctlr,
+		    st.smmu_sample_cbar);
+		printf("RAIN FTS: %s gsnap ch=%#x/%#x ev=%#x rp=%#x glob=%#x gpii=%#x err=%#x type=%#x evt=%#x/%#x\n",
+		    stage, st.gsnap[0], st.gsnap[1], st.gsnap[2], st.gsnap[3],
+		    st.gsnap[4], st.gsnap[5], st.gsnap[6], st.gsnap[7],
+		    st.ev_last[0], st.ev_last[1]);
+		printf("RAIN FTS: %s noirq=%d\n", stage, st.noirq);
+		printf("RAIN FTS: %s xsnap wp0=%#x rp1=%#x wp1=%#x evrp=%#x evwp=%#x se=%#x mirq=%#x ios=%#x\n",
+		    stage, st.xsnap[0], st.xsnap[1], st.xsnap[2], st.xsnap[3],
+		    st.xsnap[4], st.xsnap[5], st.xsnap[6], st.xsnap[7]);
+		if (st.stop >= 4) {
+			printf("RAIN FTS: %s fault gfsr=%#x fsr=%#x far=%#x%08x ch1rp=%#x ch1=%#x\n",
+			    stage, st.flt[0], st.flt[1], st.flt[3], st.flt[2],
+			    st.flt[4], st.flt[5]);
+		}
+	}
+}
+
+static void
+fts_thread(void *arg __unused, wait_result_t result __unused)
+{
+	uint32_t cfg;
+	unsigned delay_s = 5;
+
+	(void)PE_parse_boot_argn("rainftsdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("rainftsstop", &st.stop, sizeof(st.stop));
+	if (delay_s > 0) {
+		printf("RAIN FTS: starting in %u s\n", delay_s);
+		fts_sleep(delay_s * 1000u);
+	}
+	st.geni = ml_io_map(FTS_GENI_PA, FTS_GENI_LEN);
+	st.tlmm = ml_io_map(FTS_TLMM_PA, FTS_TLMM_LEN);
+	st.gcc = ml_io_map(FTS_GCC_PA, FTS_GCC_LEN);
+	if (st.geni == 0 || st.tlmm == 0 || st.gcc == 0) {
+		printf("RAIN FTS: cannot map GENI, TLMM or GCC\n");
+		return;
+	}
+	printf("RAIN FTS: geni=%#lx tlmm=%#lx\n", (unsigned long)st.geni,
+	    (unsigned long)st.tlmm);
+
+	/* The ABL may have muxed the SPI pins already. Read the known WEST
+	 * tile addresses first; do not change any pin without the survey. */
+	for (unsigned pin = FTS_SPI_PINS; pin < FTS_SPI_PINS + FTS_SPI_PIN_N; pin++) {
+		cfg = fts_rd(st.tlmm, pin * FTS_TLMM_STRIDE);
+		st.pin_cfg[pin] = cfg;
+		printf("RAIN FTS: gpio%u cfg=%#x function=%u pull=%u drive=%u out=%u\n",
+		    pin, cfg, (cfg >> 2) & 0xf, cfg & 3, (cfg >> 6) & 7, (cfg >> 9) & 1);
+	}
+	for (unsigned pin = FTS_IRQ_GPIO; pin <= FTS_RESET_GPIO; pin++) {
+		cfg = fts_rd(st.tlmm, pin * FTS_TLMM_STRIDE);
+		st.pin_cfg[4u + pin - FTS_IRQ_GPIO] = cfg;
+		printf("RAIN FTS: gpio%u cfg=%#x function=%u pull=%u drive=%u out=%u\n",
+		    pin, cfg, (cfg >> 2) & 0xf, cfg & 3, (cfg >> 6) & 7, (cfg >> 9) & 1);
+	}
+
+	/* The reset line is active low. Only pulse it when explicitly asked;
+	 * the first survey and the Hello-screen boot must remain read-only. */
+	int rst = 0;
+	PE_parse_boot_argn("rainftsrst", &rst, sizeof(rst));
+	if (rst) {
+		fts_gpio(FTS_RESET_GPIO, 0u, 1u, 4u, true, false);
+		fts_gpio(FTS_IRQ_GPIO, 0u, 2u, 4u, false, false);
+		for (unsigned i = 0; i < FTS_RESET_LOOPS; i++) {
+			fts_gpio(FTS_RESET_GPIO, 0u, 1u, 4u, true, false);
+			fts_sleep(2);
+			fts_gpio(FTS_RESET_GPIO, 0u, 1u, 4u, true, true);
+			fts_sleep(2);
+		}
+		printf("RAIN FTS: reset pulsed\n");
+	} else {
+		printf("RAIN FTS: reset not pulsed (rainftsrst=1 to do it)\n");
+	}
+
+	fts_survey();
+	/*
+	 * Programming the serial engine and moving bytes is a separate step:
+	 * the survey above only reads. A wrong register write can take the
+	 * board down, so the transfers wait for rainftstx=1.
+	 */
+	int tx = 0;
+	PE_parse_boot_argn("rainftstx", &tx, sizeof(tx));
+	if (!tx) {
+		printf("RAIN FTS: survey only (rainftstx=1 to enable transfers)\n");
+		for (unsigned n = 0; n < 18; n++) {
+			fts_sleep(10000);
+			printf("RAIN FTS: cached fw=%#x status=%#x fifo=%u/%u,%u/%u gpio0=%#x gpio1=%#x gpio2=%#x gpio3=%#x irq80=%#x rst86=%#x\n",
+			    st.fw, st.status, st.tx_depth, st.tx_width, st.rx_depth,
+			    st.rx_width, st.pin_cfg[0], st.pin_cfg[1], st.pin_cfg[2],
+			    st.pin_cfg[3], st.pin_cfg[4], st.pin_cfg[10]);
+		}
+		return;
+	}
+
+	if ((st.fw & FW_REV_PROTOCOL_MSK) >> FW_REV_PROTOCOL_SHFT != PROTO_SPI ||
+	    st.tx_width != 32u || st.rx_width != 32u ||
+	    st.tx_depth < 4u || st.rx_depth < 4u) {
+		printf("RAIN FTS: unexpected GENI protocol or FIFO; SPI withheld\n");
+		fts_repeat("geni-withheld");
+		return;
+	}
+	if (!fts_clocks()) {
+		fts_repeat("clk-withheld");
+		return;
+	}
+	st.ifdis = fts_rd(st.geni, SE_IF_DISABLE);
+	if (st.ifdis & FIFO_IF_DISABLE) {
+		st.gsi = true;
+		printf("RAIN FTS: GENI FIFO interface disabled; using GPI DMA\n");
+		if (!fts_gpi_init()) {
+			printf("RAIN FTS: GPI bring-up stopped at '%c' (smmu '%c')\n",
+			    st.gpi_stage, st.smmu_mode);
+			fts_repeat(st.gpi_stage == 'S' ? "stop-smmu" : "gpi-withheld");
+			return;
+		}
+		if (st.stop == 2) {
+			printf("RAIN FTS: GPI ready; stopping before any transfer\n");
+			fts_repeat("stop-gpi");
+			return;
+		}
+	}
+	/* The live qupv3_se0_spi_active pinctrl is qup0, no pull, 6 mA.
+	 * On bengal/khaje GPIO 0..3 select qup0 with function 1. */
+	for (unsigned pin = 0; pin < FTS_SPI_PIN_N; pin++)
+		fts_gpio(pin, 1u, 0u, 2u, false, false);
+	/* The controller reset is active low; release it without a pulse. */
+	fts_gpio(FTS_RESET_GPIO, 0u, 1u, 3u, true, true);
+	fts_sleep(30);
+	printf("RAIN FTS: SPI pins muxed gpio0=%#x gpio3=%#x reset-io=%#x\n",
+	    fts_rd(st.tlmm, 0), fts_rd(st.tlmm, 3u * FTS_TLMM_STRIDE),
+	    fts_rd(st.tlmm, FTS_RESET_GPIO * FTS_TLMM_STRIDE + 4u));
+	fts_se_setup(4u); /* 19.2 MHz / 4 = 4.8 MHz */
+	if (st.dead) {
+		fts_repeat("se-busy");
+		return;
+	}
+	if (st.stop == 3) {
+		printf("RAIN FTS: SE set up; stopping before the first transfer\n");
+		fts_repeat("stop-se");
+		return;
+	}
+	if (st.stop == 4 && st.gsi) {
+		gpi_rx_fetch_probe();
+		fts_repeat("stop-rx");
+		return;
+	}
+	if (st.stop == 5 && st.gsi) {
+		gpi_cfg_probe();
+		fts_repeat("stop-cfg");
+		return;
+	}
+	if (st.stop == 6 && st.gsi) {
+		gpi_txonly_probe();
+		fts_repeat("stop-tx");
+		return;
+	}
+	fts_probe_id();
+	int probe_only = 0;
+	PE_parse_boot_argn("rainftsprobe", &probe_only, sizeof(probe_only));
+	if (probe_only) {
+		printf("RAIN FTS: one-shot probe complete; polling withheld\n");
+		fts_repeat("probe");
+		return;
+	}
+
+	/* Try to read the app-mode firmware version: a non-zero reply means
+	 * the controller has firmware loaded and will produce touch reports. */
+	uint8_t fwcmd = FTS_FW_VER_REG;
+	uint8_t fwbuf[4];
+	int fwerr = fts_read(&fwcmd, 1, fwbuf, 2);
+	if (!fwerr) {
+		printf("RAIN FTS: fw version %02x %02x\n", fwbuf[0], fwbuf[1]);
+	} else {
+		printf("RAIN FTS: fw version read failed: %d (controller may be in boot mode)\n", fwerr);
+	}
+
+	printf("RAIN FTS: entering touch poll (10 ms interval)\n");
+	unsigned errors = 0;
+	while (!st.dead) {
+		int err = fts_poll_touch();
+		if (err) {
+			if ((errors++ % 200u) == 0) {
+				printf("RAIN FTS: touch err=%d count=%u\n", err, errors);
+			}
+			if (errors == 10) {
+				fts_touch_report(0, st.x, st.y);
+			}
+		} else {
+			errors = 0;
+		}
+		fts_sleep(10);
+	}
+	fts_touch_report(0, st.x, st.y);
+	printf("RAIN FTS: touch poll ended\n");
+}
+
+void
+rain_touch_init(void)
+{
+	thread_t thread;
+	kern_return_t kr;
+	int on = 0;
+
+	/* Off unless asked for: stage 1 is a diagnostic. */
+	PE_parse_boot_argn("rainfts", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	kr = kernel_thread_start(fts_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("RAIN FTS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
