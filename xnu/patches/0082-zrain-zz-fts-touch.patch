+/*
+ * Rain (Redmi 10C) FT8006S touchscreen on the GENI SPI block.
+ *
+ * The controller is a Focaltech FT8006S (chip id 0x8642) on GENI SPI at
+ * 0x4a80000, chip select 0. The live device tree has the SPI pins on
+ * GPIO 0..3 muxed to qup0, the interrupt on GPIO 80 and the reset on
+ * GPIO 86. Android drives it with the fts_ts driver; the inherited XNU
+ * touch driver only speaks I2C on Sweet's SE7, so it cannot reach it.
+ *
+ * Stage 1 is the transport and the controller identity:
+ *   - what the pinctrl and the GENI block look like right now,
+ *   - the Focaltech SPI framing (a four byte header, three dummy bytes and
+ *     a CRC-16/KERMIT over the payload),
+ *   - the chip id read.
+ * The report parser and the firmware loader follow once the chip answers.
+ *
+ * Everything is bounded and runs on one worker thread: a failure here must
+ * not stop the rest of the system from booting.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void rain_touch_init(void);
+
+/* Hardware. */
+#define FTS_GENI_PA      0x04a80000u
+#define FTS_GENI_LEN     0x00004000u
+/*
+ * The TLMM (the device tree's pinctrl@400000) is not flat: the GPIO number
+ * selects a tile and the pin sits at tile + number * 0x1000. On this SoC
+ * (the bengal pinctrl driver) the tiles are WEST at +0x100000, SOUTH at
+ * +0x500000, EAST at +0x900000 and the base tile is unused. The touch's
+ * pins are all in WEST: GPIO 0..3 are the qup0 SPI pins, GPIO 80 is the
+ * interrupt and GPIO 86 the reset. Reading a pin in the wrong tile hits
+ * an unimplemented register aperture, which aborts the board.
+ */
+#define FTS_TLMM_PA      0x00500000u
+#define FTS_TLMM_LEN     0x00060000u
+#define FTS_TLMM_STRIDE  0x00001000u
+#define FTS_SPI_PINS     0u          /* GPIO 0..3: the qup0 SPI pins */
+#define FTS_SPI_PIN_N    4u
+#define FTS_IRQ_GPIO     80u
+#define FTS_RESET_GPIO   86u
+#define FTS_RESET_LOOPS  20u
+
+/* The GENI serial engine register map. It is the same map Sweet's SE7 I2C
+ * engine uses, so the offsets and the byte order carry over unchanged. */
+#define SE_STATUS        0x040u
+#define SE_MCLK          0x048u
+#define SE_FW            0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_PACK0_TX      0x260u
+#define SE_PACK1_TX      0x264u
+#define SE_PACK0_RX      0x284u
+#define SE_PACK1_RX      0x288u
+#define SE_CMD           0x600u
+#define SE_CTRL          0x604u
+#define SE_IRQ           0x610u
+#define SE_IRQ_EN        0x614u
+#define SE_IRQ_CLR       0x618u
+#define SE_TX            0x700u
+#define SE_RX            0x780u
+#define SE_TX_COUNT      0x800u
+#define SE_RX_COUNT      0x804u
+#define SE_TX_WM         0x80cu
+#define SE_RX_WM         0x810u
+#define SE_RX_RFR_WM     0x814u
+#define SE_DMA_MODE      0x258u
+#define SE_HW_TX         0xe24u
+#define SE_HW_RX         0xe28u
+
+/* The SPI specific registers of the same block. */
+#define SE_SPI_CPHA      0x224u
+#define SE_SPI_LOOPBACK  0x22cu
+#define SE_SPI_CPOL      0x230u
+#define SE_SPI_DEMUX_INV 0x24cu
+#define SE_SPI_DEMUX_SEL 0x250u
+#define SE_SPI_TRANS_CFG 0x25cu
+#define SE_SPI_WORD_LEN  0x268u
+#define SE_SPI_TX_LEN    0x26cu
+#define SE_SPI_RX_LEN    0x270u
+#define SE_SPI_DELAY     0x278u
+
+/* GENI fields. */
+#define FW_REV_PROTOCOL_MSK  0xff00u
+#define FW_REV_PROTOCOL_SHFT 8u
+#define PROTO_SPI            1u
+#define M_CMD_DONE_EN        0x00000001u
+#define M_RX_FIFO_WM_EN      0x04000000u
+#define M_RX_FIFO_LAST_EN    0x08000000u
+#define M_TX_FIFO_WM_EN      0x40000000u
+#define M_CMD_DONE           0x00000001u
+#define M_CMD_ABORT          0x00000002u
+#define M_CMD_CANCEL         0x00000004u
+#define M_CMD_OVERRUN        0x00000002u
+#define M_ILLEGAL_CMD        0x00000004u
+#define M_CMD_FAILURE        0x00000008u
+#define SPI_TX_ONLY          1u
+#define SPI_RX_ONLY          2u
+#define M_OPCODE_SHFT        27u
+#define TX_FIFO_DEPTH_MSK    0x003f0000u
+#define TX_FIFO_DEPTH_SHFT   16u
+#define TX_FIFO_WIDTH_MSK    0x3f000000u
+#define TX_FIFO_WIDTH_SHFT   24u
+#define RX_FIFO_DEPTH_MSK    0x003f0000u
+#define RX_FIFO_DEPTH_SHFT   16u
+#define RX_FIFO_WIDTH_MSK    0x3f000000u
+#define RX_FIFO_WIDTH_SHFT   24u
+#define TX_FIFO_WC_MSK       0x0fffffffu
+#define RX_FIFO_WC_MSK       0x01ffffffu
+
+/* The packing for eight bit words, four per FIFO word, most significant
+ * bit first. These are the values Sweet's I2C engine already uses. */
+#define SE_PACK0            0x0007f8feu
+#define SE_PACK1            0x000ffefeu
+
+/* The Focaltech SPI framing. */
+#define FTS_WRITE_CMD       0x00u
+#define FTS_READ_CMD        0xa0u    /* 0x80 | DATA_CRC_EN */
+#define FTS_HEADER_LEN      4u
+#define FTS_DUMMY_BYTES     3u
+#define FTS_MAX_XFER        256u
+#define FTS_CHIP_ID_REG     0x90u    /* FTS_CMD_READ_ID */
+#define FTS_FW_VER_REG      0xa6u    /* firmware version in app mode */
+#define FTS_MAX_TOUCH       10u
+#define FTS_TOUCH_REG       0x01u    /* touch data starts here */
+#define FTS_TOUCH_LEN       62u      /* 2 header + 60 point bytes */
+
+/* Khaje GCC: wrap0's voted clocks and SE0 RCG (gcc-khaje.c). */
+#define FTS_GCC_PA       0x01400000u
+#define FTS_GCC_LEN      0x00080000u
+#define FTS_GCC_VOTE     0x0007900cu
+#define FTS_GCC_SE0_RCG  0x0001f148u
+#define FTS_GCC_VOTE_MASK 0x000007c0u /* AHB, core, core2x, SE0 */
+#define FTS_GCC_SE0_CBCR 0x0001f144u
+#define FTS_GCC_CORE_CBCR 0x0001f00cu
+
+static struct {
+	vm_offset_t geni, tlmm, gcc;
+	bool dead;
+	uint32_t tx_depth, tx_width, rx_depth, rx_width;
+	uint32_t irq_last;
+	uint32_t fw, status, pin_cfg[11];
+	uint32_t active;
+	int x[FTS_MAX_TOUCH], y[FTS_MAX_TOUCH];
+} st;
+static int fts_sleep_chan;
+
+static uint32_t
+fts_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+fts_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+fts_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&fts_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* The poll loops use the kernel's delay(): assert_wait_deadline with a
+ * deadline in the past does not necessarily leave the thread runnable, and
+ * a thread that blocks there never finishes. */
+static void
+fts_pause(void)
+{
+	delay(1);
+}
+
+/* The TLMM configuration of one pin: function, pull, drive and direction.
+ *
+ * The layout is: the pull in bits [1:0], the function in bits [5:2], the
+ * drive strength in bits [8:6] (three bits, so 0 to 7) and the output
+ * enable in bit 9. A drive value of 8 would set the output enable
+ * instead, so it must stay below 8.
+ */
+static void
+fts_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = pin * FTS_TLMM_STRIDE;
+	uint32_t cfg = fts_rd(st.tlmm, off);
+	if (out) {
+		fts_wr(st.tlmm, off + 4u,
+		    (fts_rd(st.tlmm, off + 4u) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	fts_wr(st.tlmm, off, cfg);
+}
+
+/* Tell what the GENI block says about itself. */
+static void
+fts_survey(void)
+{
+	uint32_t fw = fts_rd(st.geni, SE_FW);
+	uint32_t htx = fts_rd(st.geni, SE_HW_TX);
+	uint32_t hrx = fts_rd(st.geni, SE_HW_RX);
+	uint32_t status = fts_rd(st.geni, SE_STATUS);
+	uint32_t proto = (fw & FW_REV_PROTOCOL_MSK) >> FW_REV_PROTOCOL_SHFT;
+
+	st.tx_depth = (htx & TX_FIFO_DEPTH_MSK) >> TX_FIFO_DEPTH_SHFT;
+	st.tx_width = (htx & TX_FIFO_WIDTH_MSK) >> TX_FIFO_WIDTH_SHFT;
+	st.rx_depth = (hrx & RX_FIFO_DEPTH_MSK) >> RX_FIFO_DEPTH_SHFT;
+	st.rx_width = (hrx & RX_FIFO_WIDTH_MSK) >> RX_FIFO_WIDTH_SHFT;
+	st.fw = fw;
+	st.status = status;
+	printf("RAIN FTS: geni fw=%#x proto=%u status=%#x tx_fifo=%u/%u rx_fifo=%u/%u\n",
+	    fw, proto, status, st.tx_depth, st.tx_width, st.rx_depth, st.rx_width);
+	if (proto != PROTO_SPI) {
+		printf("RAIN FTS: GENI is not in SPI mode (proto=%u); the ABL firmware is not loaded\n", proto);
+	}
+	if (st.tx_width != 32 || st.rx_width != 32) {
+		printf("RAIN FTS: unexpected FIFO width, SPI needs 32 bit words\n");
+	}
+}
+
+/* Select the 19.2 MHz XO parent, enable only QUP0/SE0 clocks, and
+ * verify the voted branches before touching the serial sequencer. */
+static bool
+fts_clocks(void)
+{
+	uint32_t rcg = FTS_GCC_SE0_RCG;
+	uint32_t dfs = fts_rd(st.gcc, rcg + 0x14u);
+	uint32_t cfg = fts_rd(st.gcc, rcg + (dfs & 1u ? 0x1cu : 4u));
+	printf("RAIN FTS: GCC before vote=%#x dfs=%#x cfg=%#x\n",
+	    fts_rd(st.gcc, FTS_GCC_VOTE), dfs, cfg);
+	if (dfs & 1u) {
+		if ((cfg & 0x371fu) != 1u) {
+			printf("RAIN FTS: DFS level 0 is not XO/1; SPI withheld\n");
+			return false;
+		}
+	} else {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		fts_wr(st.gcc, rcg + 4u, cfg);
+		fts_wr(st.gcc, rcg, fts_rd(st.gcc, rcg) | 1u);
+		unsigned n;
+		for (n = 0; n < 5000u && (fts_rd(st.gcc, rcg) & 1u); n++)
+			fts_pause();
+		if (n == 5000u) {
+			printf("RAIN FTS: SE0 RCG update timed out; SPI withheld\n");
+			return false;
+		}
+	}
+	fts_wr(st.gcc, FTS_GCC_VOTE,
+	    fts_rd(st.gcc, FTS_GCC_VOTE) | FTS_GCC_VOTE_MASK);
+	for (unsigned n = 0; n < 5000u; n++) {
+		if (!(fts_rd(st.gcc, FTS_GCC_SE0_CBCR) & (1u << 31)) &&
+		    !(fts_rd(st.gcc, FTS_GCC_CORE_CBCR) & (1u << 31))) {
+			printf("RAIN FTS: GCC ready vote=%#x se0=%#x\n",
+			    fts_rd(st.gcc, FTS_GCC_VOTE),
+			    fts_rd(st.gcc, FTS_GCC_SE0_CBCR));
+			return true;
+		}
+		fts_pause();
+	}
+	printf("RAIN FTS: GCC branches halted; SPI withheld\n");
+	return false;
+}
+
+/* Put the serial engine into FIFO mode with the SPI parameters set. */
+static void
+fts_se_setup(uint32_t speed_div)
+{
+	uint32_t val;
+
+	/* An idle GENI engine is required before changing FIFO parameters. */
+	if (fts_rd(st.geni, SE_STATUS) & 1u) {
+		printf("RAIN FTS: GENI command still active; SPI withheld\n");
+		st.dead = true;
+		return;
+	}
+	fts_wr(st.geni, SE_IRQ_CLR, 0xffffffffu);
+	fts_wr(st.geni, SE_DMA_MODE, fts_rd(st.geni, SE_DMA_MODE) & ~1u);
+	fts_wr(st.geni, SE_RX_WM, 0);
+	fts_wr(st.geni, SE_RX_RFR_WM, st.rx_depth - 2u);
+
+	/* The SPI parameters: mode 0, chip select 0, eight bit words. */
+	fts_wr(st.geni, SE_SPI_LOOPBACK, 0);
+	fts_wr(st.geni, SE_SPI_DEMUX_SEL, 0);
+	fts_wr(st.geni, SE_SPI_CPHA, 0);
+	fts_wr(st.geni, SE_SPI_CPOL, 0);
+	fts_wr(st.geni, SE_SPI_DEMUX_INV, 0);
+	fts_wr(st.geni, SE_SPI_TRANS_CFG, 0);
+	fts_wr(st.geni, SE_SPI_WORD_LEN, 8u - 4u);
+	fts_wr(st.geni, SE_SPI_DELAY, 0);
+
+	/* The packing: eight bit words, four per FIFO word, MSB first. */
+	fts_wr(st.geni, SE_PACK0_TX, SE_PACK0);
+	fts_wr(st.geni, SE_PACK1_TX, SE_PACK1);
+	fts_wr(st.geni, SE_PACK0_RX, SE_PACK0);
+	fts_wr(st.geni, SE_PACK1_RX, SE_PACK1);
+
+	/* The serial engine clock: the divider and the clock enable. */
+	fts_wr(st.geni, SE_CLK_SEL, 0);
+	fts_wr(st.geni, SE_MCLK, (speed_div << 4) | 1u);
+
+	/* The interrupts the FIFO transfer needs. */
+	val = fts_rd(st.geni, SE_IRQ_EN);
+	val |= M_CMD_DONE_EN | M_TX_FIFO_WM_EN | M_RX_FIFO_WM_EN | M_RX_FIFO_LAST_EN;
+	fts_wr(st.geni, SE_IRQ_EN, val);
+}
+
+/* One full duplex SPI transfer. */
+static int
+fts_spi_xfer(const uint8_t *tx, unsigned txlen, uint8_t *rx, unsigned rxlen)
+{
+	unsigned sent = 0, got = 0;
+	uint32_t irq;
+
+	if (txlen > FTS_MAX_XFER || rxlen > FTS_MAX_XFER) {
+		return EIO;
+	}
+	fts_wr(st.geni, SE_IRQ_CLR, 0xffffffffu);
+	fts_wr(st.geni, SE_TX_WM, 0);
+	fts_wr(st.geni, SE_SPI_TX_LEN, txlen);
+	fts_wr(st.geni, SE_SPI_RX_LEN, rxlen);
+	/* The primary sequencer: transmit and receive at once. */
+	fts_wr(st.geni, SE_CMD, ((SPI_TX_ONLY | SPI_RX_ONLY) << M_OPCODE_SHFT));
+
+	/* Push the transmit words. The FIFO holds a few, so the rest follows
+	 * the watermark interrupt. */
+	while (sent < txlen) {
+		uint32_t word = 0;
+		unsigned n = txlen - sent;
+		if (n > 4) {
+			n = 4;
+		}
+		/* Never overrun the FIFO: drain it first when it is full. */
+		unsigned i;
+		for (i = 0; i < 2000; i++) {
+			if (!(fts_rd(st.geni, SE_TX_COUNT) & TX_FIFO_WC_MSK)) {
+				break;
+			}
+			fts_wr(st.geni, SE_TX_WM, 1u);
+			fts_pause();
+		}
+		if (i == 2000) {
+			fts_wr(st.geni, SE_CTRL, M_CMD_ABORT);
+			return ETIMEDOUT;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			word |= (uint32_t)tx[sent + i] << (8u * i);
+		}
+		fts_wr(st.geni, SE_TX, word);
+		sent += n;
+	}
+	fts_wr(st.geni, SE_TX_WM, 0);
+
+	/* Drain the receive FIFO until the transfer is done. */
+	for (unsigned i = 0; i < 20000; i++) {
+		uint32_t count = fts_rd(st.geni, SE_RX_COUNT) & RX_FIFO_WC_MSK;
+		while (count--) {
+			uint32_t word = fts_rd(st.geni, SE_RX);
+			if (rx == NULL) {
+				continue;
+			}
+			for (unsigned j = 0; j < 4 && got < rxlen; j++) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		irq = fts_rd(st.geni, SE_IRQ);
+		st.irq_last = irq;
+		if (irq & (M_CMD_OVERRUN | M_ILLEGAL_CMD | M_CMD_FAILURE)) {
+			printf("RAIN FTS: SPI error irq=%#x status=%#x\n", irq,
+			    fts_rd(st.geni, SE_STATUS));
+			fts_wr(st.geni, SE_IRQ_CLR, irq);
+			fts_wr(st.geni, SE_CTRL, M_CMD_ABORT);
+			fts_wr(st.geni, SE_IRQ_CLR, 0xffffffffu);
+			return EIO;
+		}
+		if (irq & M_CMD_DONE) {
+			fts_wr(st.geni, SE_IRQ_CLR, irq);
+			return got >= rxlen ? 0 : EIO;
+		}
+		fts_wr(st.geni, SE_IRQ_CLR, irq & (M_RX_FIFO_WM_EN | M_RX_FIFO_LAST_EN | M_TX_FIFO_WM_EN));
+		fts_pause();
+	}
+	printf("RAIN FTS: SPI transfer timed out, irq=%#x status=%#x\n",
+	    st.irq_last, fts_rd(st.geni, SE_STATUS));
+	fts_wr(st.geni, SE_CTRL, M_CMD_ABORT);
+	fts_wr(st.geni, SE_IRQ_CLR, 0xffffffffu);
+	return ETIMEDOUT;
+}
+
+/* The Focaltech framing: an address, a command, the length, three dummy
+ * bytes and the payload. The write path is reserved for the firmware loader,
+ * which comes with the report parser. */
+static int fts_write(const uint8_t *data, unsigned len) __unused;
+
+static int
+fts_write(const uint8_t *data, unsigned len)
+{
+	uint8_t buf[FTS_MAX_XFER];
+	unsigned total = FTS_HEADER_LEN + FTS_DUMMY_BYTES + len - 1u;
+
+	if (len < 2 || total > FTS_MAX_XFER) {
+		return EIO;
+	}
+	buf[0] = data[0];
+	buf[1] = FTS_WRITE_CMD;
+	buf[2] = (uint8_t)((len - 1u) >> 8);
+	buf[3] = (uint8_t)(len - 1u);
+	memset(&buf[4], 0, FTS_DUMMY_BYTES);
+	memcpy(&buf[FTS_HEADER_LEN + FTS_DUMMY_BYTES], &data[1], len - 1u);
+	return fts_spi_xfer(buf, total, NULL, 0);
+}
+
+/* A read returns the payload followed by its two CRC bytes. */
+static int
+fts_read(const uint8_t *cmd, unsigned cmdlen, uint8_t *data, unsigned len)
+{
+	uint8_t buf[FTS_MAX_XFER];
+	uint8_t reply[FTS_MAX_XFER];
+	unsigned total = FTS_HEADER_LEN + FTS_DUMMY_BYTES + len + 2u;
+	int error;
+
+	if (total > FTS_MAX_XFER || len == 0 || cmdlen == 0) {
+		return EIO;
+	}
+	buf[0] = cmd[0];
+	buf[1] = FTS_READ_CMD;
+	buf[2] = (uint8_t)(len >> 8);
+	buf[3] = (uint8_t)len;
+	memset(&buf[4], 0, total - FTS_HEADER_LEN);
+	error = fts_spi_xfer(buf, total, reply, total);
+	if (error) {
+		return error;
+	}
+	if (reply[3] & 0xa0u) {
+		printf("RAIN FTS: read addr=%02x status=%02x raw=%02x %02x %02x %02x\n",
+		    cmd[0], reply[3], reply[4], reply[5], reply[6], reply[7]);
+		return EIO;
+	}
+	memcpy(data, &reply[FTS_HEADER_LEN + FTS_DUMMY_BYTES], len + 2u);
+	return 0;
+}
+
+static uint16_t
+fts_crc(const uint8_t *data, unsigned len)
+{
+	uint16_t crc = 0xffff;
+	for (unsigned i = 0; i < len; i++) {
+		crc ^= data[i];
+		for (unsigned j = 0; j < 8; j++) {
+			crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0x8408u) : (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+/* The identity of the controller: the boot id register pair. */
+static void
+fts_probe_id(void)
+{
+	uint8_t cmd = FTS_CHIP_ID_REG;
+	uint8_t buf[16];
+	uint16_t calc, read;
+	int error;
+
+	memset(buf, 0, sizeof(buf));
+	error = fts_read(&cmd, 1, buf, 2);
+	if (error) {
+		printf("RAIN FTS: chip id read failed: %d\n", error);
+		return;
+	}
+	calc = fts_crc(buf, 2);
+	read = (uint16_t)((buf[3] << 8) | buf[2]);
+	printf("RAIN FTS: boot id %02x %02x crc %04x/%04x\n", buf[0], buf[1], calc, read);
+	if (buf[0] == 0x86 && buf[1] == 0x32) {
+		printf("RAIN FTS: FT8006S answered\n");
+	} else {
+		printf("RAIN FTS: unexpected chip id\n");
+	}
+}
+
+static void
+fts_touch_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < FTS_MAX_TOUCH; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] ||
+			    y[id] != st.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+/* Read and parse one FT8006S touch frame from register 0x01. */
+static int
+fts_poll_touch(void)
+{
+	uint8_t cmd = FTS_TOUCH_REG;
+	uint8_t buf[FTS_TOUCH_LEN + 2u];
+	int x[FTS_MAX_TOUCH] = {0}, y[FTS_MAX_TOUCH] = {0};
+	uint32_t mask = 0, seen = 0;
+	uint16_t calc, recv;
+
+	int err = fts_read(&cmd, 1, buf, FTS_TOUCH_LEN);
+	if (err) {
+		return err;
+	}
+	calc = fts_crc(buf, FTS_TOUCH_LEN);
+	recv = (uint16_t)((buf[FTS_TOUCH_LEN + 1u] << 8) | buf[FTS_TOUCH_LEN]);
+	if (calc != recv) {
+		return EIO;
+	}
+	unsigned n = buf[1] & 0x0fu;
+	if (n > FTS_MAX_TOUCH) {
+		return EIO;
+	}
+	if (n == 0) {
+		fts_touch_report(0, st.x, st.y);
+		return 0;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 2u + 6u * i;
+		unsigned id = p[2] >> 4;
+		unsigned event = p[0] >> 6;
+		if (id >= FTS_MAX_TOUCH) {
+			break;
+		}
+		if (seen & (1u << id)) {
+			return EIO;
+		}
+		seen |= 1u << id;
+		if (event == 1u) {
+			continue;
+		}
+		unsigned px = ((unsigned)(p[0] & 0x0fu) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 0x0fu) << 8) | p[3];
+		if (px > 719 || py > 1649) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	fts_touch_report(mask, x, y);
+	return 0;
+}
+
+static void
+fts_thread(void *arg __unused, wait_result_t result __unused)
+{
+	uint32_t cfg;
+	unsigned delay_s = 5;
+
+	(void)PE_parse_boot_argn("rainftsdelay", &delay_s, sizeof(delay_s));
+	if (delay_s > 0) {
+		printf("RAIN FTS: starting in %u s\n", delay_s);
+		fts_sleep(delay_s * 1000u);
+	}
+	st.geni = ml_io_map(FTS_GENI_PA, FTS_GENI_LEN);
+	st.tlmm = ml_io_map(FTS_TLMM_PA, FTS_TLMM_LEN);
+	st.gcc = ml_io_map(FTS_GCC_PA, FTS_GCC_LEN);
+	if (st.geni == 0 || st.tlmm == 0 || st.gcc == 0) {
+		printf("RAIN FTS: cannot map GENI, TLMM or GCC\n");
+		return;
+	}
+	printf("RAIN FTS: geni=%#lx tlmm=%#lx\n", (unsigned long)st.geni,
+	    (unsigned long)st.tlmm);
+
+	/* The ABL may have muxed the SPI pins already. Read the known WEST
+	 * tile addresses first; do not change any pin without the survey. */
+	for (unsigned pin = FTS_SPI_PINS; pin < FTS_SPI_PINS + FTS_SPI_PIN_N; pin++) {
+		cfg = fts_rd(st.tlmm, pin * FTS_TLMM_STRIDE);
+		st.pin_cfg[pin] = cfg;
+		printf("RAIN FTS: gpio%u cfg=%#x function=%u pull=%u drive=%u out=%u\n",
+		    pin, cfg, (cfg >> 2) & 0xf, cfg & 3, (cfg >> 6) & 7, (cfg >> 9) & 1);
+	}
+	for (unsigned pin = FTS_IRQ_GPIO; pin <= FTS_RESET_GPIO; pin++) {
+		cfg = fts_rd(st.tlmm, pin * FTS_TLMM_STRIDE);
+		st.pin_cfg[4u + pin - FTS_IRQ_GPIO] = cfg;
+		printf("RAIN FTS: gpio%u cfg=%#x function=%u pull=%u drive=%u out=%u\n",
+		    pin, cfg, (cfg >> 2) & 0xf, cfg & 3, (cfg >> 6) & 7, (cfg >> 9) & 1);
+	}
+
+	/* The reset line is active low. Only pulse it when explicitly asked;
+	 * the first survey and the Hello-screen boot must remain read-only. */
+	int rst = 0;
+	PE_parse_boot_argn("rainftsrst", &rst, sizeof(rst));
+	if (rst) {
+		fts_gpio(FTS_RESET_GPIO, 0u, 1u, 4u, true, false);
+		fts_gpio(FTS_IRQ_GPIO, 0u, 2u, 4u, false, false);
+		for (unsigned i = 0; i < FTS_RESET_LOOPS; i++) {
+			fts_gpio(FTS_RESET_GPIO, 0u, 1u, 4u, true, false);
+			fts_sleep(2);
+			fts_gpio(FTS_RESET_GPIO, 0u, 1u, 4u, true, true);
+			fts_sleep(2);
+		}
+		printf("RAIN FTS: reset pulsed\n");
+	} else {
+		printf("RAIN FTS: reset not pulsed (rainftsrst=1 to do it)\n");
+	}
+
+	fts_survey();
+	/*
+	 * Programming the serial engine and moving bytes is a separate step:
+	 * the survey above only reads. A wrong register write can take the
+	 * board down, so the transfers wait for rainftstx=1.
+	 */
+	int tx = 0;
+	PE_parse_boot_argn("rainftstx", &tx, sizeof(tx));
+	if (!tx) {
+		printf("RAIN FTS: survey only (rainftstx=1 to enable transfers)\n");
+		for (unsigned n = 0; n < 18; n++) {
+			fts_sleep(10000);
+			printf("RAIN FTS: cached fw=%#x status=%#x fifo=%u/%u,%u/%u gpio0=%#x gpio1=%#x gpio2=%#x gpio3=%#x irq80=%#x rst86=%#x\n",
+			    st.fw, st.status, st.tx_depth, st.tx_width, st.rx_depth,
+			    st.rx_width, st.pin_cfg[0], st.pin_cfg[1], st.pin_cfg[2],
+			    st.pin_cfg[3], st.pin_cfg[4], st.pin_cfg[10]);
+		}
+		return;
+	}
+
+	if ((st.fw & FW_REV_PROTOCOL_MSK) >> FW_REV_PROTOCOL_SHFT != PROTO_SPI ||
+	    st.tx_width != 32u || st.rx_width != 32u ||
+	    st.tx_depth < 4u || st.rx_depth < 4u) {
+		printf("RAIN FTS: unexpected GENI protocol or FIFO; SPI withheld\n");
+		return;
+	}
+	if (!fts_clocks())
+		return;
+	/* The live qupv3_se0_spi_active pinctrl is qup0, no pull, 6 mA.
+	 * On bengal/khaje GPIO 0..3 select qup0 with function 1. */
+	for (unsigned pin = 0; pin < FTS_SPI_PIN_N; pin++)
+		fts_gpio(pin, 1u, 0u, 2u, false, false);
+	/* The controller reset is active low; release it without a pulse. */
+	fts_gpio(FTS_RESET_GPIO, 0u, 1u, 3u, true, true);
+	fts_sleep(30);
+	printf("RAIN FTS: SPI pins muxed gpio0=%#x gpio3=%#x reset-io=%#x\n",
+	    fts_rd(st.tlmm, 0), fts_rd(st.tlmm, 3u * FTS_TLMM_STRIDE),
+	    fts_rd(st.tlmm, FTS_RESET_GPIO * FTS_TLMM_STRIDE + 4u));
+	fts_se_setup(4u); /* 19.2 MHz / 4 = 4.8 MHz */
+	if (st.dead)
+		return;
+	fts_probe_id();
+	int probe_only = 0;
+	PE_parse_boot_argn("rainftsprobe", &probe_only, sizeof(probe_only));
+	if (probe_only) {
+		printf("RAIN FTS: one-shot probe complete; polling withheld\n");
+		return;
+	}
+
+	/* Try to read the app-mode firmware version: a non-zero reply means
+	 * the controller has firmware loaded and will produce touch reports. */
+	uint8_t fwcmd = FTS_FW_VER_REG;
+	uint8_t fwbuf[4];
+	int fwerr = fts_read(&fwcmd, 1, fwbuf, 2);
+	if (!fwerr) {
+		printf("RAIN FTS: fw version %02x %02x\n", fwbuf[0], fwbuf[1]);
+	} else {
+		printf("RAIN FTS: fw version read failed: %d (controller may be in boot mode)\n", fwerr);
+	}
+
+	printf("RAIN FTS: entering touch poll (10 ms interval)\n");
+	unsigned errors = 0;
+	while (!st.dead) {
+		int err = fts_poll_touch();
+		if (err) {
+			if ((errors++ % 200u) == 0) {
+				printf("RAIN FTS: touch err=%d count=%u\n", err, errors);
+			}
+			if (errors == 10) {
+				fts_touch_report(0, st.x, st.y);
+			}
+		} else {
+			errors = 0;
+		}
+		fts_sleep(10);
+	}
+	fts_touch_report(0, st.x, st.y);
+	printf("RAIN FTS: touch poll ended\n");
+}
+
+void
+rain_touch_init(void)
+{
+	thread_t thread;
+	kern_return_t kr;
+	int on = 0;
+
+	/* Off unless asked for: stage 1 is a diagnostic. */
+	PE_parse_boot_argn("rainfts", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	kr = kernel_thread_start(fts_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("RAIN FTS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
